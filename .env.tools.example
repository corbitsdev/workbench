# Template for tool-package publishing. Copy to `.env.staging` and
# `.env.production` (both gitignored) and fill in per environment, then:
#
#   bun run tools:push:staging      # builds + publishes with .env.staging
#   bun run tools:push:production   # builds + publishes with .env.production
#
# These push the built tarballs to the `workspace-builtins` package-registry
# asset on the target hub. Keep the real .env.* files out of git.

# Hub base URL for the target environment.
HUB_URL=https://hub.staging.example.com

# Admin account used to obtain a session for the asset REST API.
HUB_ADMIN_EMAIL=
HUB_ADMIN_PASSWORD=

# Slug of the tenant that owns the workspace-builtins asset (the shared org tenant).
HUB_TENANT_SLUG=
