{
  "name": "@corbits/granola-tools",
  "version": "0.0.5",
  "description": "Granola integration: a minimal client and an @intx/agent tool bundle for listing a user's recent call notes",
  "license": "LGPL-2.1-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/corbitsdev/workbench.git",
    "directory": "tools/granola"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "arktype": "catalog:"
  },
  "devDependencies": {
    "@corbits/credential-providers": "workspace:*",
    "@intx/authz": "0.3.0",
    "@intx/crypto": "0.3.0",
    "@intx/db": "workspace:*",
    "@intx/harness": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@intx/agent": "0.3.0",
    "@intx/types": "0.3.0"
  },
  "interchange": {
    "credentials": [
      {
        "handle": "granola"
      }
    ]
  }
}
