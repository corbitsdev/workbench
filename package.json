{
  "name": "gtm-workbench",
  "version": "0.6.85",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "workflows/*",
    "interchange/packages/*",
    "interchange/apps/admin-ui"
  ],
  "scripts": {
    "db:setup": "bun --env-file=.env run scripts/db-setup.ts",
    "db:seed": "bun --env-file=.env run scripts/db-seed.ts",
    "db:reset": "bun --env-file=.env run scripts/db-reset.ts",
    "dev": "bun --env-file=.env.local run --parallel --filter @workbench/web --filter @workbench/hub --filter @workbench/sidecar dev",
    "build": "bun run --parallel --filter @workbench/web --filter @workbench/hub build",
    "typecheck": "bun run --filter '@workbench/*' typecheck",
    "format": "bun run scripts/format-changed.ts",
    "format:all": "prettier --write .",
    "lint": "prettier --check . && eslint . && bun run lint:no-effect-fetch",
    "lint:no-effect-fetch": "bun run scripts/lint-no-effect-fetch.ts",
    "test": "bun run --filter '@workbench/*' test",
    "test:coverage": "bun run --filter '@workbench/*' test:coverage",
    "coverage:report": "COVERAGE_THRESHOLD=80 bun run scripts/coverage-merge.ts",
    "coverage": "bun run test:coverage && bun run coverage:report",
    "interchange:check": "bun run scripts/check-interchange-sync.ts"
  },
  "dependencies": {
    "arktype": "catalog:",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.7",
    "isomorphic-git": "^1.35.1",
    "postgres": "^3.4.9",
    "resend": "^4.0.0"
  },
  "overrides": {
    "@types/bun": "1.3.9",
    "bun-types": "1.3.9"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "typescript-eslint": "8.42.0",
    "typescript-language-server": "^5.3.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "catalog": {
    "@types/semver": "^7.7.1",
    "arktype": "^2.2.0",
    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.7",
    "isomorphic-git": "^1.27.2",
    "semver": "^7.7.2",
    "ssri": "^12.0.0",
    "tar": "^7.5.1",
    "typescript": "^5.9.0"
  }
}
