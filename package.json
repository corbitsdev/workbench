{
  "name": "workbench",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "workspaces": [
    "apps/*",
    "packages/*",
    "vendor/intx/*",
    "workflows/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "oxlint apps packages workflows scripts e2e",
    "fmt": "oxfmt apps packages workflows scripts e2e",
    "fmt:check": "oxfmt --check apps packages workflows scripts e2e",
    "build": "bun run scripts/run-all.ts build",
    "test": "bun run scripts/run-all.ts test",
    "test:e2e": "bun test e2e",
    "dev": "bun run scripts/dev.ts",
    "setup": "bun scripts/db-setup.ts",
    "setup:memory": "bun run scripts/setup-memory.ts",
    "reset": "bun scripts/reset.ts"
  },
