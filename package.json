{
  "name": "gtm-workbench",
  "version": "0.1.18",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "workflows/*",
    "interchange/packages/*",
    "interchange/apps/admin-ui"
  ],
  "scripts": {
    "db:setup": "bun --env-file=.env run scripts/db-setup.ts",
    "db:seed": "bun --env-file=.env run scripts/db-seed.ts",
    "db:reset": "bun --env-file=.env run scripts/db-reset.ts",
    "dev": "bun --env-file=.env run --parallel --filter @workbench/web --filter @workbench/hub --filter @workbench/sidecar --filter @intx/admin-ui dev",
    "build": "bun run --parallel --filter @workbench/web --filter @workbench/hub build",
    "tools:build": "bun run --filter @workbench/hub build:tool-packages",
    "tools:publish": "bun run apps/hub/bin/publish-tool-packages.ts --from dist/tool-packages",
    "tools:push": "bun run tools:build && bun run tools:publish",
    "workflows:push": "bun run apps/hub/bin/deploy-workflow.ts",
    "tools:push:staging": "bun run tools:build && bun --env-file=.env.staging run apps/hub/bin/publish-tool-packages.ts --from dist/tool-packages",
    "tools:push:production": "bun run tools:build && bun --env-file=.env.production run apps/hub/bin/publish-tool-packages.ts --from dist/tool-packages",
    "typecheck": "bun run --filter '@workbench/*' typecheck",
    "format": "oxfmt --write . '!interchange' '!temporary'",
    "lint": "bun run --filter '@workbench/*' lint && bun run lint:no-effect-fetch",
    "lint:no-effect-fetch": "bun run scripts/lint-no-effect-fetch.ts",
    "test": "bun run --filter '@workbench/*' test",
    "test:coverage": "bun run --filter '@workbench/*' test:coverage",
    "coverage:report": "COVERAGE_THRESHOLD=80 bun run scripts/coverage-merge.ts",
    "coverage": "bun run test:coverage && bun run coverage:report",
    "interchange:check": "bun run scripts/check-interchange-sync.ts"
  },
  "dependencies": {
    "arktype": "catalog:",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.7",
    "isomorphic-git": "^1.35.1",
    "postgres": "^3.4.9",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "catalog": {
    "@types/semver": "^7.7.1",
    "arktype": "^2.1.29",
    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.7",
    "isomorphic-git": "^1.27.2",
    "semver": "^7.7.2",
    "ssri": "^12.0.0",
    "tar": "^7.5.1",
    "typescript": "^5.9.0"
  }
}
