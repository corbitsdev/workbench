{
  "name": "workbench",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "workspaces": [
    "agents/*",
    "apps/*",
    "packages/*",
    "skills/*",
    "tools/*",
    "vendor/intx/*",
    "workflows/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run fmt:check && bun run test",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "oxlint apps packages tools agents skills workflows scripts test e2e",
    "fmt": "oxfmt apps packages tools agents skills workflows scripts test e2e",
    "fmt:check": "oxfmt --check apps packages tools agents skills workflows scripts test e2e",
    "build": "bun run scripts/run-all.ts build",
    "test": "bun run scripts/run-all.ts test",
    "dev": "bun run scripts/dev.ts",
    "publish-tools": "bun scripts/publish-tools.ts",
    "setup": "bun scripts/db-setup.ts",
    "setup:memory": "bun run scripts/setup-memory.ts",
    "reset": "bun scripts/reset.ts",
    "build:sidecar-image": "docker build -f apps/sidecar-docker/Dockerfile -t corbits-sidecar:dev ."
  },
  "devDependencies": {
    "@corbits/artifacts": "github:corbitsdev/corbits-artifacts#5309a15d4aa504f132c54b4da08bb672b4903873",
    "@corbits/codex-provider": "github:corbitsdev/corbits-codex-provider#a1f475f341261c05fa8dade0c82f1246c175b5b3",
    "@corbits/evals": "workspace:*",
    "@corbits/ollama-adapter": "workspace:*",
    "@corbits/xai-provider": "github:corbitsdev/corbits-xai-provider#9f2d4bac40ea075df092fef807404a13c638cf14",
    "@intx/db": "workspace:*",
    "@intx/crypto": "workspace:*",
    "@intx/log": "workspace:*",
    "@corbits/connections": "workspace:*",
    "@corbits/mailbox": "github:corbitsdev/corbits-mailbox#e85b81e4a2e0cc318dd33a4f0f92337b6fac7f38",
    "@intx/mime": "0.3.0",
    "@intx/types": "0.3.0",
    "@types/bun": "1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "jiti": "^2.7.0",
    "oxlint": "1.83.0",
    "oxfmt": "0.68.0",
    "puppeteer-core": "^25.7.0",
    "typescript": "6.0.3",
    "@corbits/webhook-triggers": "workspace:*"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "catalog": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "arktype": "^2.2.0",
    "typescript": "6.0.3",
    "@types/bun": "^1.3.9",
    "@types/semver": "^7.7.1",
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.9",
    "isomorphic-git": "^1.27.2",
    "postgres": "^3.4.8",
    "semver": "^7.7.2",
    "ssri": "^12.0.0",
    "tar": "^7.5.1",
    "@types/ssri": "^7.1.5",
    "@types/react-dom": "^19.2.2"
  },
  "trustedDependencies": [
    "@corbits/react-ui",
    "@corbits/mailbox"
  ],
  "dependencies": {
    "arktype": "catalog:"
  },
  "overrides": {
    "arktype": "^2.2.0",
    "@intx/agent": "workspace:*",
    "@intx/authz": "0.3.0",
    "@intx/crypto": "0.3.0",
    "@intx/db": "workspace:*",
    "@intx/harness": "workspace:*",
    "@intx/hub-agent": "workspace:*",
    "@intx/hub-api": "workspace:*",
    "@intx/hub-common": "0.3.0",
    "@intx/hub-sessions": "workspace:*",
    "@intx/inference": "workspace:*",
    "@intx/inference-catalog": "0.3.0",
    "@intx/log": "0.3.0",
    "@intx/mail-memory": "workspace:*",
    "@intx/mime": "workspace:*",
    "@intx/pack-transport": "0.3.0",
    "@intx/storage-isogit": "0.3.0",
    "@intx/tool-packaging": "0.3.0",
    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*",
    "@intx/workflow-deploy": "workspace:*",
    "@intx/workflow-host": "workspace:*",
    "better-auth": "1.6.29",
    "hono": "4.13.3",
    "@intx/mailbox": "workspace:*"
  }
}
