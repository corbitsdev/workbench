{
  "name": "workbench",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*",
    "vendor/intx/*",
    "workflows/*"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run test",
    "typecheck": "bun run scripts/run-all.ts typecheck",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "build": "bun run scripts/run-all.ts build",
    "test": "bun run scripts/run-all.ts test",
    "test:e2e": "bun test scripts/e2e",
    "dev": "bun run scripts/dev.ts",
    "check:deletion": "bun run scripts/checks/deletion.ts",
    "check:killdates": "bun run scripts/checks/killdates.ts",
    "check:packages": "bun run scripts/checks/packages.ts",
    "check:no-product-tenancy": "bun run scripts/checks/no-product-tenancy.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/bun": "1.3.14",
    "eslint": "^10.8.0",
    "jiti": "^2.7.0",
    "prettier": "^3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.42.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "catalog": {
    "arktype": "^2.2.0",
    "typescript": "6.0.3",
    "@types/bun": "^1.3.9",
    "@types/semver": "^7.7.1",
    "better-auth": "^1.4.18",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.9",
    "isomorphic-git": "^1.27.2",
    "postgres": "^3.4.8",
    "semver": "^7.7.2",
    "ssri": "^12.0.0",
    "tar": "^7.5.1"
  },
  "trustedDependencies": [
    "@corbits/react-ui"
  ],
  "dependencies": {
    "arktype": "^2.2.0"
  }
}
