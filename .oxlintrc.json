{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "unicorn/consistent-function-scoping": "off",
    "unicorn/prefer-string-starts-ends-with": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/prefer-add-event-listener": "off",
    "unicorn/no-useless-spread": "off",
    "unicorn/no-useless-fallback-in-spread": "off",
    "no-shadow": "off",
    "no-underscore-dangle": "off",
    "no-unmodified-loop-condition": "off",
    "no-unused-expressions": ["error", { "allowTaggedTemplates": true }],
    "no-unsafe-optional-chaining": "off",
    "no-useless-concat": "off",
    "unicorn/no-thenable": "off",
    "unicorn/no-new-array": "off",
    "unicorn/require-module-specifiers": "off",
    "no-console": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "vendor/**",
    "node_modules/**",
    "dist/**",
    ".worktrees/**",
    ".data/**",
    "*.gen.*"
  ],
  "overrides": [
    {
      "files": ["**/src/**/*.ts", "**/src/**/*.tsx"],
      "excludeFiles": [
        "**/src/**/*.test.ts",
        "**/src/**/*.test.tsx",
        "apps/web/src/lib/client-log/index.ts"
      ],
      "rules": {
        "no-console": "error"
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "excludeFiles": ["apps/web/src/lib/icons/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "lucide-react",
                "message": "lucide-react is retired — import from @/lib/icons instead."
              },
              {
                "name": "@phosphor-icons/react",
                "message": "Import icons from @/lib/icons, not @phosphor-icons/react directly."
              }
            ],
            "patterns": [
              {
                "group": ["@phosphor-icons/react/*"],
                "message": "Import icons from @/lib/icons, not @phosphor-icons/react directly."
              }
            ]
          }
        ]
      }
    }
  ]
}