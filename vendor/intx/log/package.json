{
  "name": "@intx/log",
  "description": "Structured logging with per-package loggers and pluggable development and production sinks",
  "version": "0.2.2",
  "license": "LGPL-2.1-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./hono": {
      "types": "./src/hono.ts",
      "default": "./src/hono.ts"
    }
  },
  "dependencies": {
    "@logtape/hono": "^2.0.2",
    "@logtape/logtape": "^2.0.2"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/index.ts",
    "./src/hono.ts",
    "./src/default-sink.ts"
  ],
  "publishConfig": {
    "access": "public"
  }
}
