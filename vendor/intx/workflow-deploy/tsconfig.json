{
  "extends": "../tsconfig.base.json",
  "include": [
    "src/**/*.ts",
    "package.json",
    "src/**/*.json"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "compilerOptions": {
    "types": [
      "bun"
    ],
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "references": [
    {
      "path": "../agent"
    },
    {
      "path": "../types"
    },
    {
      "path": "../workflow"
    }
  ]
}
