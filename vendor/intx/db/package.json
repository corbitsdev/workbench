{
  "name": "@intx/db",
  "description": "Client, schema, migrations, and row parsers for the hub's PostgreSQL database",
  "version": "0.2.2",
  "license": "LGPL-2.1-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "dependencies": {
    "@intx/authz": "workspace:*",
    "@intx/log": "workspace:*",
    "@intx/types": "workspace:*",
    "arktype": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.9"
  },
  "files": [
    "src",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
