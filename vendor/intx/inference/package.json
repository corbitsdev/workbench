{
  "name": "@intx/inference",
  "description": "Provider-agnostic inference runtime with Anthropic, OpenAI, and Google GenAI adapters",
  "version": "0.2.2",
  "license": "LGPL-2.1-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./providers": {
      "types": "./src/providers/index.ts",
      "default": "./src/providers/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@intx/log": "workspace:*",
    "@intx/types": "workspace:*",
    "arktype": "catalog:"
  },
  "devDependencies": {
    "@intx/mime": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
