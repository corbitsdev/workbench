{
  "name": "@intx/storage-isogit",
  "description": "Git-backed ContextStore and AuditStore with pack send/receive for moving repositories over the wire",
  "version": "0.2.2",
  "license": "LGPL-2.1-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@intx/log": "workspace:*",
    "@intx/mime": "workspace:*",
    "@intx/types": "workspace:*",
    "@isomorphic-git/lightning-fs": "4.7.0",
    "arktype": "catalog:",
    "buffer": "^6.0.3",
    "isomorphic-git": "catalog:"
  },
  "devDependencies": {
    "@intx/crypto": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
