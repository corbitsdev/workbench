      "types": "./src/definition/index.ts",
      "default": "./src/definition/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    },
    "./runlocal": {
      "types": "./src/runlocal/index.ts",
