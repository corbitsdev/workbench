{
  "name": "@intx/hub-sessions",
  "description": "Session-orchestration substrate for the hub: sidecar router, session, and asset services",
  "version": "0.3.0",
  "license": "LGPL-2.1-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./substrate": {
      "types": "./src/substrate.ts",
      "default": "./src/substrate.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@intx/agent": "workspace:*",
    "@intx/crypto": "0.3.0",
    "@intx/db": "workspace:*",
    "@intx/hub-common": "0.3.0",
    "@intx/inference": "workspace:*",
    "@intx/log": "0.3.0",
    "@intx/mime": "workspace:*",
    "@intx/pack-transport": "0.3.0",
    "@intx/storage-isogit": "0.3.0",
    "@intx/tool-packaging": "0.3.0",
    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*",
    "@intx/workflow-deploy": "workspace:*",
    "arktype": "catalog:",
    "drizzle-orm": "catalog:",
    "isomorphic-git": "catalog:",
    "tar": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
