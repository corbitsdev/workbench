    "@intx/db": "workspace:*",
    "@intx/hub-common": "0.3.0",
    "@intx/hub-sessions": "workspace:*",
    "@intx/log": "0.3.0",
    "@intx/mime": "workspace:*",
    "@intx/storage-isogit": "0.3.0",
    "@intx/types": "workspace:*",
    "@intx/workflow-deploy": "workspace:*",
    "arktype": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "hono-openapi": "^1.2.0",
    "isomorphic-git": "catalog:",
    "ssri": "catalog:"
  },
  "devDependencies": {
    "@intx/workflow": "workspace:*",
    "@types/bun": "catalog:",
    "@types/ssri": "catalog:",
