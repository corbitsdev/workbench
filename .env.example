# Database
DATABASE_URL=postgres://workbench:workbench-dev-password@localhost:5433/workbench

# API
PORT=4000

# Auth
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_BASE_URL=http://localhost:4000

# CORS (comma-separated allowed origins, required for cross-origin auth)
SUPPORTED_CORS_ORIGINS=http://localhost:5174

# Web (required — URL of the deployed API, e.g. https://api.example.com)
VITE_API_BASE_URL=http://localhost:4000

# Hub (required)
# Directory for agent repos and signing keys on disk
HUB_DATA_DIR=./data/hub
# Versioned Ed25519 signing key(s). Format: version:hex64 (comma-separated for rotation)
# Generate: openssl rand -hex 32
HUB_SIGNING_KEYS=1:your64hexcharshere
# Credential encryption keys. Format: version:base64 (comma-separated for rotation)
# Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEYS=1:yourbase64keyhere

# Sidecar
SIDECAR_ID=gtm-sidecar-1
# Matches an entry registered in the hub
SIDECAR_TOKEN=
# WebSocket URL of the hub (same host as API for local dev)
HUB_WS_URL=ws://localhost:4000
# Directory for sidecar agent workspaces
SIDECAR_DATA_DIR=./data/sidecar

# Optional Integrations
GRANOLA_API_KEY=
EXA_API_KEY=

# Optional Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Optional Web Production Server
# API_URL=http://localhost:4000
