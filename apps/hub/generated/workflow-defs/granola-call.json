{
  "kind": "granola-call",
  "version": "0.1.0",
  "label": "Granola Call Processing",
  "description": "Automatic Granola call processing: on every run, discover recent calls and publish a digest. Bounded by maxCalls (default 10). Idempotent — a quiet run is a clean no-op, and reruns never duplicate output (CL-4283).",
  "displayFlow": [
    {
      "key": "discover",
      "label": "Discover recent calls",
      "stepIds": [
        "discover"
      ]
    },
    {
      "key": "digest",
      "label": "Write the call digest",
      "stepIds": [
        "digest"
      ],
      "activityLabel": "Writing the call digest"
    },
    {
      "key": "persist",
      "label": "Save the digest",
      "stepIds": [
        "persist"
      ]
    }
  ],
  "requiresIntake": false,
  "humanGateCount": 0,
  "intakeFields": [
    {
      "name": "maxCalls",
      "label": "Max calls per run",
      "inputHint": "text",
      "required": false,
      "help": "How many recent Granola calls to look at each run (a number). Defaults to 10.",
      "placeholder": "10",
      "order": 0
    }
  ],
  "definition": {
    "id": "granola-call",
    "triggers": [
      {
        "type": "manual"
      }
    ],
    "steps": {
      "discover": {
        "kind": "step",
        "id": "discover",
        "agent": {
          "id": "granola-call-discover",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-granola/granola:granola_list_notes"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-granola/granola:granola_list_notes",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-granola/granola:granola_list_notes",
            "workbench.argMap": "{\"limit\":{\"from\":\"maxCalls\",\"optional\":true},\"createdAfter\":{\"from\":\"createdAfter\",\"optional\":true},\"createdBefore\":{\"from\":\"createdBefore\",\"optional\":true},\"folderId\":{\"from\":\"folderId\",\"optional\":true}}",
            "workbench.title": "Discover recent calls"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "trigger.payload"
        }
      },
      "digest": {
        "kind": "step",
        "id": "digest",
        "agent": {
          "id": "granola-call-digest",
          "systemPrompt": "Treat Corbits, Corbits.dev, Interchange, and Faremeter as canonical Corbits names; spell them exactly. When source material contains a clear speech-to-text or spelling variant, use the canonical spelling in your output. Do not replace an ambiguous term unless surrounding context identifies it.\n\nYou write a short unattended digest for a Granola call-processing run.\n\nYou receive the raw granola_list_notes result (JSON: notes[], hasMore, cursor?) for the most recent notes, bounded by the run's maxCalls.\n\nWrite a concise markdown digest:\n1. One-line headline: how many calls were found (0 is fine — say so plainly, e.g. \"No new calls since the last run.\")\n2. For each call: title, created date, and a short one-paragraph summary of what the call covered and any notable pain points, decisions, or action items visible in its transcript/summary field\n3. Keep each call's writeup independent — this is per-call ground truth, not a single blended narrative\n\nNo preamble. No tool calls. Markdown body only.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": []
          },
          "description": "Reasoning step: granola-call-digest",
          "tags": {
            "workbench.title": "Write the call digest"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.discover.output"
        },
        "after": [
          "discover"
        ]
      },
      "persist": {
        "kind": "step",
        "id": "persist",
        "agent": {
          "id": "granola-call-persist",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-artifact/artifact:write_artifact"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-artifact/artifact:write_artifact",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-artifact/artifact:write_artifact",
            "workbench.argMap": "{\"title\":{\"literal\":\"Granola calls — digest\"},\"body\":{\"from\":\"content\"},\"kind\":{\"literal\":\"research\"},\"sourceRef\":{\"literal\":\"granola-call-digest\"},\"jobLabel\":{\"literal\":\"Granola Call Processing\"}}",
            "workbench.title": "Save the call digest"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.digest.output"
        },
        "after": [
          "digest"
        ]
      }
    },
    "stepOrder": [
      "discover",
      "digest",
      "persist"
    ]
  }
}
