{
  "kind": "granola-call",
  "version": "0.1.0",
  "label": "Granola Call Processing",
  "description": "Process one Granola call: classify internal vs external, analyze with a single agent step, persist typed artifacts, create tasks, and fan out mail.",
  "displayFlow": [
    {
      "key": "fetch",
      "label": "Fetch note",
      "stepIds": [
        "fetch"
      ]
    },
    {
      "key": "normalize",
      "label": "Normalize",
      "stepIds": [
        "normalize"
      ]
    },
    {
      "key": "classify",
      "label": "Classify",
      "stepIds": [
        "classify"
      ]
    },
    {
      "key": "build-prompt",
      "label": "Build analysis prompt",
      "stepIds": [
        "build-prompt"
      ]
    },
    {
      "key": "analyze",
      "label": "Analyze",
      "stepIds": [
        "analyze"
      ],
      "activityLabel": "Analyzing the call"
    },
    {
      "key": "parse",
      "label": "Parse analysis",
      "stepIds": [
        "parse"
      ]
    },
    {
      "key": "prepare",
      "label": "Prepare artifacts",
      "stepIds": [
        "prepare"
      ]
    },
    {
      "key": "persist",
      "label": "Persist artifacts",
      "stepIds": [
        "persist-pain",
        "persist-summary",
        "persist-brief"
      ],
      "activityLabel": "Saving call artifacts"
    },
    {
      "key": "create-tasks",
      "label": "Create tasks",
      "stepIds": [
        "create-tasks"
      ]
    },
    {
      "key": "fanout",
      "label": "Fan out",
      "stepIds": [
        "fanout"
      ]
    },
    {
      "key": "emit",
      "label": "Emit outputs",
      "stepIds": [
        "emit"
      ]
    }
  ],
  "requiresIntake": false,
  "humanGateCount": 0,
  "definition": {
    "id": "granola-call",
    "triggers": [
      {
        "type": "manual"
      }
    ],
    "steps": {
      "fetch": {
        "kind": "step",
        "id": "fetch",
        "agent": {
          "id": "granola-call-fetch",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-granola/granola:granola_get_note"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-granola/granola:granola_get_note",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-granola/granola:granola_get_note",
            "workbench.argMap": "{\"noteId\":{\"from\":\"noteId\"}}",
            "workbench.title": "Fetch note"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "trigger.payload"
        }
      },
      "normalize": {
        "kind": "step",
        "id": "normalize",
        "agent": {
          "id": "granola-call-normalize",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-granola/workflow:granola_normalize_note"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-granola/workflow:granola_normalize_note",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-granola/workflow:granola_normalize_note",
            "workbench.title": "Normalize"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.fetch.output"
        },
        "after": [
          "fetch"
        ]
      },
      "classify": {
        "kind": "step",
        "id": "classify",
        "agent": {
          "id": "granola-call-classify",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-granola/workflow:granola_classify_call"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-granola/workflow:granola_classify_call",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-granola/workflow:granola_classify_call",
            "workbench.argMap": "{\"note\":{\"from\":\"content\"},\"tenantDomain\":{\"from\":\"tenantDomain\"}}",
            "workbench.title": "Classify"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.normalize.output"
            },
            {
              "from": "trigger.payload"
            }
          ]
        },
        "after": [
          "normalize"
        ]
      },
      "build-prompt": {
        "kind": "step",
        "id": "build-prompt",
        "agent": {
          "id": "granola-call-build-prompt",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-granola/workflow:granola_build_analysis_prompt"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-granola/workflow:granola_build_analysis_prompt",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-granola/workflow:granola_build_analysis_prompt",
            "workbench.title": "Build analysis prompt"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.normalize.output"
        },
        "after": [
          "normalize"
        ]
      },
      "analyze": {
        "kind": "step",
        "id": "analyze",
        "agent": {
          "id": "granola-call-analyze",
          "systemPrompt": "Treat Corbits, Corbits.dev, Interchange, and Faremeter as canonical Corbits names; spell them exactly. When source material contains a clear speech-to-text or spelling variant, use the canonical spelling in your output. Do not replace an ambiguous term unless surrounding context identifies it.\n\nYou analyze a sales/meeting call transcript and return STRICT JSON only (no prose, no code fences).\n\nReturn an object with these keys:\n- \"summary\": a concise plain-text summary of the call (3-6 sentences).\n- \"painPoints\": string[] — customer pain points / problems raised.\n- \"decisions\": string[] — decisions made on the call.\n- \"actionItems\": { \"description\": string, \"assignee\"?: string }[] — near-term action items. Set \"assignee\" to the person's name or email when the transcript makes it clear who owns it; omit otherwise.\n- \"tasks\": { \"description\": string, \"assignee\"?: string }[] — concrete follow-up tasks (may overlap conceptually with action items but should be the trackable work).\n- \"peopleMentioned\": string[] — names or emails of people discussed but not necessarily attendees.\n\nOutput ONLY the JSON object.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": []
          },
          "description": "Reasoning step: granola-call-analyze",
          "tags": {
            "workbench.title": "Analyze"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.build-prompt.output"
        },
        "after": [
          "build-prompt"
        ]
      },
      "parse": {
        "kind": "step",
        "id": "parse",
        "agent": {
          "id": "granola-call-parse",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-granola/workflow:granola_parse_analysis"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-granola/workflow:granola_parse_analysis",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-granola/workflow:granola_parse_analysis",
            "workbench.title": "Parse analysis"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.analyze.output"
        },
        "after": [
          "analyze"
        ]
      },
      "prepare": {
        "kind": "step",
        "id": "prepare",
        "agent": {
          "id": "granola-call-prepare",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-granola/workflow:granola_prepare_artifacts"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-granola/workflow:granola_prepare_artifacts",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-granola/workflow:granola_prepare_artifacts",
            "workbench.title": "Prepare artifacts"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "project": {
            "from": "steps"
          },
          "fields": [
            "normalize",
            "parse",
            "classify"
          ]
        },
        "after": [
          "normalize",
          "parse",
          "classify"
        ]
      },
      "persist-pain": {
        "kind": "step",
        "id": "persist-pain",
        "agent": {
          "id": "granola-call-persist-pain",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-artifact/artifact:write_artifact"
          ],
          "inference": {
            "sources": []
