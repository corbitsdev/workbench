          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-artifact/artifact:write_artifact",
            "workbench.argMap": "{\"title\":{\"from\":\"painTitle\"},\"kind\":{\"from\":\"painKind\"},\"body\":{\"from\":\"painContent\"},\"sourceRef\":{\"from\":\"painSourceRef\"}}",
            "workbench.title": "Persist pain points"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.prepare.output"
        },
        "after": [
          "prepare"
