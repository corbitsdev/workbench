{
  "kind": "prospect-engine",
  "version": "0.1.0",
  "label": "Prospect engine",
  "description": "Nightly unattended prospecting: Sumble discover → qualify → map contacts → scored list + Slack digest. List building only — never outreach.",
  "displayFlow": [
    {
      "key": "prelude",
      "label": "Load budget and exclusion lists",
      "stepIds": [
        "initBudget",
        "findLedger",
        "readLedger",
        "parseLedger",
        "pipeline",
        "growthList",
        "enterpriseList",
        "extractListOrgs"
      ]
    },
    {
      "key": "discover",
      "label": "Discover candidates",
      "stepIds": [
        "discover"
      ]
    },
    {
      "key": "filter",
      "label": "Dedupe and score",
      "stepIds": [
        "extractDiscoverCandidates",
        "dedupe",
        "score",
        "extractScoreCandidates",
        "qualify"
      ]
    },
    {
      "key": "map",
      "label": "Map contacts",
      "stepIds": [
        "mapReveal"
      ]
    },
    {
      "key": "package",
      "label": "Package report",
      "stepIds": [
        "extractMapRevealOverlay",
        "formatReport",
        "persist",
        "formatDigest"
      ]
    },
    {
      "key": "deliver",
      "label": "Deliver",
      "stepIds": [
        "mergeLedger",
        "saveLedger",
        "addGrowth",
        "addEnterprise",
        "mailRefs",
        "mail",
        "notify"
      ]
    }
  ],
  "requiresIntake": false,
  "humanGateCount": 0,
  "intakeFields": [
    {
      "kind": "text",
      "name": "slackChannelId",
      "label": "Slack channel id (#prospect-engine, optional — digest always mails to your inbox)",
      "placeholder": "C…",
      "required": false
    },
    {
      "kind": "select",
      "name": "growthEngineListId",
      "label": "Engine - Growth Sumble list",
      "optionsSource": "sumble-organization-lists",
      "required": true
    },
    {
      "kind": "select",
      "name": "enterpriseEngineListId",
      "label": "Engine - Enterprise Sumble list",
      "optionsSource": "sumble-organization-lists",
      "required": true
    },
    {
      "kind": "string-array",
      "name": "verticals",
      "label": "Vertical focus (optional)",
      "placeholder": "AI, payments, legal tech"
    }
  ],
  "definition": {
    "id": "prospect-engine",
    "triggers": [
      {
        "type": "manual"
      }
    ],
    "steps": {
      "initBudget": {
        "kind": "action",
        "id": "initBudget",
        "handler": "@workbench/tools-prospect-engine/core:prospect_engine_init_budget",
        "drainBehavior": "cancel",
        "input": {
          "literal": {}
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine/core:prospect_engine_init_budget"
          ]
        }
      },
      "findLedger": {
        "kind": "action",
        "id": "findLedger",
        "handler": "@workbench/tools-artifact/artifact:artifact_find_by_title",
        "drainBehavior": "cancel",
        "input": {
          "literal": {
            "title": "Prospect engine — seen-accounts ledger",
            "kind": "prospect-engine-ledger"
          }
        },
        "effect": {
          "requires": [
            "@workbench/tools-artifact/artifact:artifact_find_by_title"
          ]
        },
        "after": [
          "initBudget"
        ]
      },
      "readLedger": {
        "kind": "action",
        "id": "readLedger",
        "handler": "@workbench/tools-prospect-engine/ledger-bridge:prospect_engine_read_ledger_tolerant",
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.findLedger.output"
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine/ledger-bridge:prospect_engine_read_ledger_tolerant"
          ]
        },
        "after": [
          "findLedger"
        ]
      },
      "parseLedger": {
        "kind": "action",
        "id": "parseLedger",
        "handler": "@workbench/tools-prospect-engine/core:prospect_engine_parse_ledger",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.initBudget.output.content"
            },
            {
              "from": "steps.readLedger.output"
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine/core:prospect_engine_parse_ledger"
          ]
        },
        "after": [
          "initBudget",
          "readLedger"
        ]
      },
      "pipeline": {
        "kind": "action",
        "id": "pipeline",
        "handler": "@workbench/tools-prospect-engine-sumble-bridge/list:prospect_engine_read_organization_list_tolerant",
        "drainBehavior": "cancel",
        "input": {
          "literal": 80088
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine-sumble-bridge/list:prospect_engine_read_organization_list_tolerant"
          ]
        },
        "after": [
          "parseLedger"
        ]
      },
      "growthList": {
        "kind": "action",
        "id": "growthList",
        "handler": "@workbench/tools-prospect-engine-sumble-bridge/list:prospect_engine_read_organization_list_tolerant",
        "drainBehavior": "cancel",
        "input": {
          "from": "trigger.payload.growthEngineListId"
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine-sumble-bridge/list:prospect_engine_read_organization_list_tolerant"
          ]
        },
        "after": [
          "parseLedger"
        ]
      },
      "enterpriseList": {
        "kind": "action",
        "id": "enterpriseList",
        "handler": "@workbench/tools-prospect-engine-sumble-bridge/list:prospect_engine_read_organization_list_tolerant",
        "drainBehavior": "cancel",
        "input": {
          "from": "trigger.payload.enterpriseEngineListId"
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine-sumble-bridge/list:prospect_engine_read_organization_list_tolerant"
          ]
        },
        "after": [
          "parseLedger"
        ]
      },
      "extractListOrgs": {
        "kind": "action",
        "id": "extractListOrgs",
        "handler": "@workbench/tools-prospect-engine/core:prospect_engine_extract_list_org_ids",
        "drainBehavior": "cancel",
        "input": {
          "project": {
            "from": "steps"
          },
          "fields": [
            "pipeline",
            "growthList",
            "enterpriseList"
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine/core:prospect_engine_extract_list_org_ids"
          ]
        },
        "after": [
          "pipeline",
          "growthList",
          "enterpriseList"
        ]
      },
      "discover": {
        "kind": "step",
        "id": "discover",
        "agent": {
          "id": "prospect-engine-discover",
          "systemPrompt": "You are the Corbits overnight prospect engine discover step. You run unattended.\n\nGoal: collect ~30 net-new candidate organizations for Corbits / Interchange (agent OS: audit and control of AI agents at scale). Never contact anyone. Never write to Sumble lists, mail, Slack, artifacts, or memory.\n\nLane A (~60%): Series A-C, ~20-500 employees, verticals AI, payments, workflow, legal tech, family offices, logistics, devtools.\nLane B (~40%): enterprise or regulated (finserv, banking, insurance, healthcare) with agent/GenAI hiring.\n\nProcess:\n1. Resolve tech/job-function names with sumble_find_technologies / sumble_lookup_technologies / sumble_lookup_job_titles BEFORE filtering. Known-good tech slugs: langchain, openai-gpt-models, anthropic-claude, crewai, n8n, mcp.\n2. Run 2-3 org filter queries per lane via sumble_search_organizations (agent-stack query: LLM, RAG, LangChain, OpenAI, Anthropic, vector DBs, agent frameworks). Prefer job_post_concentration style evidence when available.\n3. Run sumble_search_signals for GenAI-project and new-AI-leader signals.\n4. Skip Ramp AI Index when rampAIIndexInputs is absent; note \"Ramp skipped\" in notes.\n5. Do not use person_score as primary ranker. Collect evidence only.\n\nHard constraints:\n- Cap awareness: 800 Sumble credits / 45 minutes for the whole run. Prefer cheap searches.\n- Pipeline list id 80088 is exclusion only (already loaded upstream).\n- No write tools. No email/phone reveals in this step.\n\nReturn ONE strict JSON object (no markdown fence) with:\n- candidates: array of { organizationId (number), name?, domain?, slug?, lane (\"growth\"|\"enterprise\"), industry?, employeeCount?, fundingRound?, fundingDate?, sumbleUrl?, evidence?: string[], whyNow? }\n- queriesRun: string[]\n- notes: string (include \"Ramp skipped\" when applicable)\n",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-sumble/sumble:sumble_search_organizations",
            "@workbench/tools-sumble/sumble:sumble_search_signals",
            "@workbench/tools-sumble/sumble:sumble_find_technologies",
            "@workbench/tools-sumble/sumble:sumble_lookup_technologies",
            "@workbench/tools-sumble/sumble:sumble_lookup_job_titles",
            "@workbench/tools-sumble/sumble:sumble_get_organization_signals",
            "@workbench/tools-sumble/sumble:sumble_resolve_organization",
            "@workbench/tools-prospect-engine/core:prospect_engine_charge_credits"
          ],
          "inference": {
            "sources": [
              {
                "provider": "openai-compatible",
                "model": "deepseek-v4-flash"
              }
            ]
          },
          "description": "Read-only Sumble discovery for overnight prospect engine.",
          "tags": {
            "credentialName": "opencode-zen",
            "workbench.title": "Discover candidates"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "trigger.payload"
            },
            {
              "from": "steps.initBudget.output"
            },
            {
              "from": "steps.parseLedger.output"
            },
            {
              "from": "steps.pipeline.output"
            },
            {
              "from": "steps.growthList.output"
            },
            {
              "from": "steps.enterpriseList.output"
            }
          ]
        },
        "after": [
          "initBudget",
          "parseLedger",
          "pipeline",
          "growthList",
          "enterpriseList",
          "extractListOrgs"
        ]
      },
      "extractDiscoverCandidates": {
        "kind": "action",
        "id": "extractDiscoverCandidates",
        "handler": "@workbench/tools-prospect-engine/core:prospect_engine_extract_candidates_from_reply",
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.discover.output"
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine/core:prospect_engine_extract_candidates_from_reply"
          ]
        },
        "after": [
          "discover"
        ]
      },
      "dedupe": {
        "kind": "action",
        "id": "dedupe",
        "handler": "@workbench/tools-prospect-engine/core:prospect_engine_dedupe_candidates",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.extractDiscoverCandidates.output.content"
            },
            {
              "from": "steps.parseLedger.output.content"
            },
            {
              "from": "steps.extractListOrgs.output.content"
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine/core:prospect_engine_dedupe_candidates"
          ]
        },
        "after": [
          "extractDiscoverCandidates",
          "parseLedger",
          "extractListOrgs"
        ]
      },
      "score": {
        "kind": "step",
        "id": "score",
        "agent": {
          "id": "prospect-engine-score",
          "systemPrompt": "Treat Corbits, Corbits.dev, Interchange, and Faremeter as canonical Corbits names; spell them exactly. When source material contains a clear speech-to-text or spelling variant, use the canonical spelling in your output. Do not replace an ambiguous term unless surrounding context identifies it.\n\nYou are the Corbits overnight prospect engine qualify step. Score each supplied candidate 0-100 with breakdown. Never invent orgs not in the input.\n\nRubric:\n- agent surface (0-30): GenAI project posts; agent-stack job mentions\n- momentum (0-20): hiring growth\n- governance need (0-20): multi-cloud, k8s/terraform, compliance/security hiring, regulated industry\n- lane fit (0-15): size, funding stage, vertical\n- why now (0-15): live signal\n\nQualify at 60+. Prefer 10-15 accounts. If fewer than 5 qualify, keep the thin set — do not pad with weak accounts.\n\nReturn ONE strict JSON object:\n- candidates: array of input candidates with score, scoreBreakdown { agentSurface, momentum, governanceNeed, laneFit, whyNow }, wedge (one-line), whyNow text, lane confirmed\n",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": [
              {
                "provider": "openai-compatible",
                "model": "kimi-k2.6",
                "parameters": {
                  "maxTokens": 8192
                }
              }
            ]
          },
          "description": "Reasoning step: prospect-engine-score",
          "tags": {
            "workbench.title": "Score candidates"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "trigger.payload"
            },
            {
              "from": "steps.dedupe.output.content"
            }
          ]
        },
        "after": [
          "dedupe"
        ]
      },
      "extractScoreCandidates": {
        "kind": "action",
        "id": "extractScoreCandidates",
        "handler": "@workbench/tools-prospect-engine/core:prospect_engine_extract_candidates_from_reply",
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.score.output"
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine/core:prospect_engine_extract_candidates_from_reply"
          ]
        },
        "after": [
          "score"
        ]
      },
      "qualify": {
        "kind": "action",
        "id": "qualify",
        "handler": "@workbench/tools-prospect-engine/core:prospect_engine_qualify",
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.extractScoreCandidates.output.content"
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine/core:prospect_engine_qualify"
          ]
        },
        "after": [
          "extractScoreCandidates"
        ]
      },
      "mapReveal": {
        "kind": "step",
        "id": "mapReveal",
        "agent": {
          "id": "prospect-engine-map-reveal",
          "systemPrompt": "You are the Corbits overnight prospect engine map/reveal step. For each qualified account, map the buying center and reveal emails for the top 2-3 contacts only.\n\nLane A titles: Head of AI, VP/Dir Eng, platform, data eng.\nLane B: add CISO, risk, compliance.\n\nRules:\n- Charge credits with prospect_engine_charge_credits using budgetId from initBudget (durable across steps). Do NOT reconstruct a budget with used:0 — that bypasses the run cap. amount is 10 credits per email reveal.\n- Use sumble_search_people with revealEmail + confirmEmailRevealSpend only after a successful charge (charged:true). If charge returns charged:false, stop reveals and keep partial contacts.\n- Never reveal phones. Never request phone attributes or confirmEmailRevealSpend for phones (80 credits, forbidden).\n- Prefer LinkedIn URLs on every contact.\n- Pull org signals when cheap and attach suggested_contacts when present.\n\nReturn ONE strict JSON object (no markdown fence). ALL fields required every night:\n- accounts: array (may be empty) of orgs with contacts: [{ name, title?, linkedinUrl?, email?, personId? }] — no phone fields\n- creditsCharged: number (sum of successful charges this step; use 0 if none)\n- stopReason: null when finished normally, or \"credit-cap\" | \"wall-clock\" | string when stopping early\n",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-sumble/sumble:sumble_search_people",
            "@workbench/tools-sumble/sumble:sumble_get_organization_signals",
            "@workbench/tools-sumble/sumble:sumble_list_jobs",
            "@workbench/tools-prospect-engine/core:prospect_engine_charge_credits"
          ],
          "inference": {
            "sources": [
              {
                "provider": "openai-compatible",
                "model": "deepseek-v4-flash"
              }
            ]
          },
          "description": "Map buying centers and reveal top contact emails under credit cap.",
          "tags": {
            "credentialName": "opencode-zen",
            "workbench.title": "Map contacts"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "trigger.payload"
            },
            {
              "from": "steps.initBudget.output.content"
            },
            {
              "from": "steps.qualify.output.content"
            }
          ]
        },
        "after": [
          "qualify",
          "initBudget"
        ]
      },
      "extractMapRevealOverlay": {
        "kind": "action",
        "id": "extractMapRevealOverlay",
        "handler": "@workbench/tools-prospect-engine/core:prospect_engine_extract_map_reveal_overlay",
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.mapReveal.output"
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine/core:prospect_engine_extract_map_reveal_overlay"
          ]
        },
        "after": [
          "mapReveal"
        ]
      },
      "formatReport": {
        "kind": "action",
        "id": "formatReport",
        "handler": "@workbench/tools-prospect-engine/core:prospect_engine_format_report",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "trigger.payload"
            },
            {
              "from": "steps.extractMapRevealOverlay.output.content"
            },
            {
              "from": "steps.qualify.output.content"
            },
            {
              "from": "steps.initBudget.output.content"
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine/core:prospect_engine_format_report"
          ]
        },
        "after": [
          "extractMapRevealOverlay",
          "qualify",
          "initBudget"
        ]
      },
      "persist": {
        "kind": "action",
        "id": "persist",
        "handler": "@workbench/tools-artifact/artifact:write_artifact",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "trigger.payload"
            },
            {
              "from": "steps.formatReport.output.content"
            },
            {
              "literal": {
                "kind": "prospect-engine-report",
                "jobLabel": "Prospect engine"
              }
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-artifact/artifact:write_artifact"
          ]
        },
        "after": [
          "formatReport"
        ]
      },
      "formatDigest": {
        "kind": "action",
        "id": "formatDigest",
        "handler": "@workbench/tools-prospect-engine/core:prospect_engine_format_slack_digest",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "trigger.payload"
            },
            {
              "from": "steps.formatReport.output.content"
            },
            {
              "from": "steps.persist.output.content"
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine/core:prospect_engine_format_slack_digest"
          ]
        },
        "after": [
          "formatReport",
          "persist"
        ]
      },
      "mergeLedger": {
        "kind": "action",
        "id": "mergeLedger",
        "handler": "@workbench/tools-prospect-engine/core:prospect_engine_merge_ledger",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "trigger.payload"
            },
            {
              "from": "steps.parseLedger.output.content"
            },
            {
              "from": "steps.formatReport.output.content"
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine/core:prospect_engine_merge_ledger"
          ]
        },
        "after": [
          "parseLedger",
          "formatReport"
        ]
      },
      "saveLedger": {
        "kind": "action",
        "id": "saveLedger",
        "handler": "@workbench/tools-artifact/artifact:write_artifact",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.mergeLedger.output.body"
            },
            {
              "literal": {
                "title": "Prospect engine — seen-accounts ledger",
                "kind": "prospect-engine-ledger",
                "jobLabel": "Prospect engine"
              }
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-artifact/artifact:write_artifact"
          ]
        },
        "after": [
          "mergeLedger"
        ]
      },
      "addGrowth": {
        "kind": "action",
        "id": "addGrowth",
        "handler": "@workbench/tools-prospect-engine-sumble-bridge/add:prospect_engine_add_organization_list_tolerant",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "trigger.payload"
            },
            {
              "from": "steps.formatReport.output.content"
            },
            {
              "literal": {
                "lane": "growth"
              }
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine-sumble-bridge/add:prospect_engine_add_organization_list_tolerant"
          ]
        },
        "after": [
          "formatReport"
        ]
      },
      "addEnterprise": {
        "kind": "action",
        "id": "addEnterprise",
        "handler": "@workbench/tools-prospect-engine-sumble-bridge/add:prospect_engine_add_organization_list_tolerant",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "trigger.payload"
            },
            {
              "from": "steps.formatReport.output.content"
            },
            {
              "literal": {
                "lane": "enterprise"
              }
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine-sumble-bridge/add:prospect_engine_add_organization_list_tolerant"
          ]
        },
        "after": [
          "formatReport"
        ]
      },
      "mailRefs": {
        "kind": "action",
        "id": "mailRefs",
        "handler": "@workbench/tools-prospect-engine/core:prospect_engine_format_mail_refs",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "trigger.payload"
            },
            {
              "from": "steps.persist.output.content"
            },
            {
              "literal": {
                "workflowLabel": "Prospect engine"
              }
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine/core:prospect_engine_format_mail_refs"
          ]
        },
        "after": [
          "persist"
        ]
      },
      "mail": {
        "kind": "action",
        "id": "mail",
        "handler": "@workbench/tools-prospect-engine/mail-bridge:prospect_engine_send_mail_tolerant",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "trigger.payload"
            },
            {
              "from": "steps.formatDigest.output.content"
            },
            {
              "from": "steps.mailRefs.output.content"
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-prospect-engine/mail-bridge:prospect_engine_send_mail_tolerant"
          ]
        },
        "after": [
          "formatDigest",
          "mailRefs"
        ]
      },
      "notify": {
        "kind": "action",
        "id": "notify",
        "handler": "@workbench/tools-prospect-engine-slack-bridge/post:prospect_engine_post_slack_tolerant",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "trigger.payload"
            },
            {
              "from": "steps.formatDigest.output.content"
            }
          ]
        },
