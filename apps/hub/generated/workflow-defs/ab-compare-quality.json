        "kind": "step",
        "id": "exec0",
        "agent": {
          "id": "exec0",
          "systemPrompt": "Treat Corbits, Corbits.dev, Interchange, and Faremeter as canonical Corbits names; spell them exactly. When source material contains a clear speech-to-text or spelling variant, use the canonical spelling in your output. Do not replace an ambiguous term unless surrounding context identifies it.\n\nYou are one entrant in a blind head-to-head model comparison.\n\nYou receive the user's task as your input. Produce the best possible answer to it.\n\nRules:\n- Treat the input as the shared task to perform; answer it directly and fully.\n- Do not explain that you are part of a comparison or being evaluated.\n- Do not mention or guess any provider identity, model identity, or variant label.\n- Return only the requested output, not commentary about the task or yourself.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": [
              {
                "provider": "openai-compatible",
                "model": "claude-opus-4-8"
              }
            ]
          },
          "description": "Inline single-turn inference: exec0",
          "tags": {
            "workbench.stepKind": "inline-inference",
            "workbench.nonFatal": "true",
            "workbench.inlineRetryMaxAttempts": "3",
            "workbench.title": "Variant 1"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.config.output.input"
        },
        "retry": {
          "maxAttempts": 3,
          "initialBackoffMs": 1000,
          "maxBackoffMs": 8000
        },
        "after": [
          "config"
