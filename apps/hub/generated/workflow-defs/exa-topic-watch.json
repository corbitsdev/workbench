{
  "kind": "exa-topic-watch",
  "version": "0.1.0",
  "label": "Web topic watch",
  "description": "On a schedule, search the web for a topic and save a short digest artifact.",
  "requiresIntake": true,
  "humanGateCount": 1,
  "intakeFields": [
    {
      "name": "topic",
      "label": "Topic",
      "inputHint": "text",
      "required": true,
      "help": "What to watch on the web each run.",
      "placeholder": "e.g. AI coding agents for GTM",
      "order": 0
    }
  ],
  "definition": {
    "id": "exa-topic-watch",
    "triggers": [
      {
        "type": "manual"
      }
    ],
    "steps": {
      "intake": {
        "kind": "awaitSignal",
        "id": "intake",
        "name": "intake",
        "drainBehavior": "wait"
      },
      "prepare-search": {
        "kind": "action",
        "id": "prepare-search",
        "handler": "@workbench/tools-exa-topic-watch/core:exa_topic_watch_prepare_search",
        "drainBehavior": "cancel",
        "input": {
          "project": {
            "from": "steps.intake.output"
          },
          "fields": [
            "topic"
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-exa-topic-watch/core:exa_topic_watch_prepare_search"
          ]
        },
        "after": [
          "intake"
        ]
      },
      "fetch": {
        "kind": "action",
        "id": "fetch",
        "handler": "@workbench/tools-exa/exa:exa_search",
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.prepare-search.output.content"
        },
        "effect": {
          "requires": [
            "@workbench/tools-exa/exa:exa_search"
          ]
        },
        "after": [
          "prepare-search"
        ]
      },
      "digest": {
        "kind": "step",
        "id": "digest",
        "agent": {
          "id": "exa-topic-watch-digest",
          "systemPrompt": "Treat Corbits, Corbits.dev, Interchange, and Faremeter as canonical Corbits names; spell them exactly. When source material contains a clear speech-to-text or spelling variant, use the canonical spelling in your output. Do not replace an ambiguous term unless surrounding context identifies it.\n\nYou write short unattended web-topic digests for a scheduled watch.\n\nYou receive the watch topic and raw Exa search results (JSON research items with url, title, publishedAt, source).\n\nWrite a concise markdown digest:\n1. One-line headline of what moved\n2. 3–7 bullet takeaways with links where useful\n3. \"Worth a closer look\" — 0–3 items with why\n\nNo preamble. No tool calls. Markdown body only.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": []
          },
          "description": "Reasoning step: exa-topic-watch-digest",
          "tags": {
            "workbench.title": "Write the digest"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.intake.output"
            },
            {
              "from": "steps.fetch.output"
            }
          ]
        },
        "after": [
          "fetch"
        ]
      },
      "document": {
        "kind": "action",
        "id": "document",
        "handler": "@workbench/tools-last30days/core:last30days_format_report_document",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.intake.output"
            },
            {
              "from": "steps.digest.output"
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-last30days/core:last30days_format_report_document"
          ]
        },
        "after": [
          "digest"
        ]
      },
      "persist": {
        "kind": "action",
        "id": "persist",
        "handler": "@workbench/tools-artifact/artifact:write_artifact",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "project": {
                "from": "steps.document.output.content"
              },
              "fields": [
                "title",
                "body"
              ]
            },
            {
              "literal": {
                "kind": "research",
                "jobLabel": "Web topic watch"
              }
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-artifact/artifact:write_artifact"
          ]
        },
        "after": [
          "document"
        ]
      }
    },
    "stepOrder": [
      "intake",
      "prepare-search",
      "fetch",
      "digest",
      "document",
      "persist"
    ]
  }
}
