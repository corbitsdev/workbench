{
  "kind": "ab-compare-standard",
  "version": "0.1.0",
  "label": "A/B Compare - Standard",
  "description": "Run one shared prompt blind across four mid-tier models (Sonnet 5, Kimi K2.6, GPT-5.4, Gemini 3.1 Pro), then pick the winner.",
  "displayFlow": [
    {
      "key": "config",
      "label": "Prompt",
      "stepIds": [
        "config"
      ]
    },
    {
      "key": "exec0",
      "label": "Variant 1",
      "stepIds": [
        "exec0"
      ]
    },
    {
      "key": "exec1",
      "label": "Variant 2",
      "stepIds": [
        "exec1"
      ]
    },
    {
      "key": "exec2",
      "label": "Variant 3",
      "stepIds": [
        "exec2"
      ]
    },
    {
      "key": "exec3",
      "label": "Variant 4",
      "stepIds": [
        "exec3"
      ]
    },
    {
      "key": "quorum",
      "label": "Check models",
      "stepIds": [
        "quorum"
      ]
    },
    {
      "key": "decision",
      "label": "Decision",
      "stepIds": [
        "decision"
      ]
    },
    {
      "key": "compose",
      "label": "Compile",
      "stepIds": [
        "compose"
      ]
    },
    {
      "key": "persist",
      "label": "Save",
      "stepIds": [
        "persist"
      ]
    }
  ],
  "requiresIntake": false,
  "humanGateCount": 2,
  "definition": {
    "id": "ab-compare-standard",
    "triggers": [
      {
        "type": "manual"
      }
    ],
    "steps": {
      "config": {
        "kind": "awaitSignal",
        "id": "config",
        "name": "ab-config",
        "drainBehavior": "wait"
      },
      "exec0": {
        "kind": "step",
        "id": "exec0",
        "agent": {
          "id": "exec0",
          "systemPrompt": "Treat Corbits, Corbits.dev, Interchange, and Faremeter as canonical Corbits names; spell them exactly. When source material contains a clear speech-to-text or spelling variant, use the canonical spelling in your output. Do not replace an ambiguous term unless surrounding context identifies it.\n\nYou are one entrant in a blind head-to-head model comparison.\n\nYou receive the user's task as your input. Produce the best possible answer to it.\n\nRules:\n- Treat the input as the shared task to perform; answer it directly and fully.\n- Do not explain that you are part of a comparison or being evaluated.\n- Do not mention or guess any provider identity, model identity, or variant label.\n- Return only the requested output, not commentary about the task or yourself.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": [
              {
                "provider": "openai-compatible",
                "model": "claude-sonnet-5"
              }
            ]
          },
          "description": "Reasoning step: exec0",
          "tags": {
            "workbench.title": "Variant 1"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.config.output.input"
        },
        "retry": {
          "maxAttempts": 3,
          "initialBackoffMs": 1000,
          "maxBackoffMs": 8000
        },
        "after": [
          "config"
        ]
      },
      "exec1": {
        "kind": "step",
        "id": "exec1",
        "agent": {
          "id": "exec1",
          "systemPrompt": "Treat Corbits, Corbits.dev, Interchange, and Faremeter as canonical Corbits names; spell them exactly. When source material contains a clear speech-to-text or spelling variant, use the canonical spelling in your output. Do not replace an ambiguous term unless surrounding context identifies it.\n\nYou are one entrant in a blind head-to-head model comparison.\n\nYou receive the user's task as your input. Produce the best possible answer to it.\n\nRules:\n- Treat the input as the shared task to perform; answer it directly and fully.\n- Do not explain that you are part of a comparison or being evaluated.\n- Do not mention or guess any provider identity, model identity, or variant label.\n- Return only the requested output, not commentary about the task or yourself.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": [
              {
                "provider": "openai-compatible",
                "model": "kimi-k2.6"
              }
            ]
          },
          "description": "Reasoning step: exec1",
          "tags": {
            "workbench.title": "Variant 2"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.config.output.input"
        },
        "retry": {
          "maxAttempts": 3,
          "initialBackoffMs": 1000,
          "maxBackoffMs": 8000
        },
        "after": [
          "config"
        ]
      },
      "exec2": {
        "kind": "step",
        "id": "exec2",
        "agent": {
          "id": "exec2",
          "systemPrompt": "Treat Corbits, Corbits.dev, Interchange, and Faremeter as canonical Corbits names; spell them exactly. When source material contains a clear speech-to-text or spelling variant, use the canonical spelling in your output. Do not replace an ambiguous term unless surrounding context identifies it.\n\nYou are one entrant in a blind head-to-head model comparison.\n\nYou receive the user's task as your input. Produce the best possible answer to it.\n\nRules:\n- Treat the input as the shared task to perform; answer it directly and fully.\n- Do not explain that you are part of a comparison or being evaluated.\n- Do not mention or guess any provider identity, model identity, or variant label.\n- Return only the requested output, not commentary about the task or yourself.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": [
              {
                "provider": "openai-compatible",
                "model": "gpt-5.4"
              }
            ]
          },
          "description": "Reasoning step: exec2",
          "tags": {
            "workbench.title": "Variant 3"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.config.output.input"
        },
        "retry": {
          "maxAttempts": 3,
          "initialBackoffMs": 1000,
          "maxBackoffMs": 8000
        },
        "after": [
          "config"
        ]
      },
      "exec3": {
        "kind": "step",
        "id": "exec3",
        "agent": {
          "id": "exec3",
          "systemPrompt": "Treat Corbits, Corbits.dev, Interchange, and Faremeter as canonical Corbits names; spell them exactly. When source material contains a clear speech-to-text or spelling variant, use the canonical spelling in your output. Do not replace an ambiguous term unless surrounding context identifies it.\n\nYou are one entrant in a blind head-to-head model comparison.\n\nYou receive the user's task as your input. Produce the best possible answer to it.\n\nRules:\n- Treat the input as the shared task to perform; answer it directly and fully.\n- Do not explain that you are part of a comparison or being evaluated.\n- Do not mention or guess any provider identity, model identity, or variant label.\n- Return only the requested output, not commentary about the task or yourself.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": [
              {
                "provider": "openai-compatible",
                "model": "gemini-3.1-pro"
              }
            ]
          },
          "description": "Reasoning step: exec3",
          "tags": {
            "workbench.title": "Variant 4"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.config.output.input"
        },
        "retry": {
          "maxAttempts": 3,
          "initialBackoffMs": 1000,
          "maxBackoffMs": 8000
        },
        "after": [
          "config"
        ]
      },
      "quorum": {
        "kind": "action",
        "id": "quorum",
        "handler": "@workbench/tools-ab-compare/compose:ab_preset_quorum",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps"
            },
            {
              "literal": {
                "__presetVariants": [
                  {
                    "label": "Variant 1",
                    "model": "claude-sonnet-5"
                  },
                  {
                    "label": "Variant 2",
                    "model": "kimi-k2.6"
                  },
                  {
                    "label": "Variant 3",
                    "model": "gpt-5.4"
                  },
                  {
                    "label": "Variant 4",
                    "model": "gemini-3.1-pro"
                  }
                ]
              }
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-ab-compare/compose:ab_preset_quorum"
          ]
        },
        "after": [
          "exec0",
          "exec1",
          "exec2",
          "exec3"
        ]
      },
      "decision": {
        "kind": "awaitSignal",
        "id": "decision",
        "name": "ab-decision",
        "drainBehavior": "wait",
        "after": [
          "quorum"
        ]
      },
      "compose": {
        "kind": "action",
        "id": "compose",
        "handler": "@workbench/tools-ab-compare/compose:ab_preset_compose",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps"
            },
            {
              "literal": {
                "__presetVariants": [
                  {
                    "label": "Variant 1",
                    "model": "claude-sonnet-5"
                  },
                  {
                    "label": "Variant 2",
                    "model": "kimi-k2.6"
                  },
                  {
                    "label": "Variant 3",
                    "model": "gpt-5.4"
                  },
                  {
                    "label": "Variant 4",
                    "model": "gemini-3.1-pro"
                  }
                ]
              }
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-ab-compare/compose:ab_preset_compose"
          ]
        },
        "after": [
          "decision"
        ]
      },
      "persist": {
        "kind": "action",
        "id": "persist",
        "handler": "@workbench/tools-artifact/artifact:artifact_create",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "project": {
                "from": "steps.compose.output"
              },
              "fields": [
                "content"
              ]
            },
            {
              "literal": {
                "title": "A/B Compare - Standard Results",
                "kind": "ab-comparison"
              }
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-artifact/artifact:artifact_create"
          ]
        },
        "after": [
          "compose"
        ]
      }
    },
    "stepOrder": [
      "config",
      "exec0",
      "exec1",
      "exec2",
      "exec3",
      "quorum",
      "decision",
      "compose",
      "persist"
    ]
  }
}
