{
  "kind": "attio-task-agent",
  "version": "0.1.0",
  "label": "Attio Task Agent",
  "description": "Pick an Attio task; an agent grounds itself in your CRM and internal context, asks only when it must, then drafts the BD artifacts you need — with your approval before anything is written back.",
  "definition": {
    "id": "attio-task-agent",
    "triggers": [
      {
        "type": "manual"
      }
    ],
    "steps": {
      "listMembers": {
        "kind": "step",
        "id": "listMembers",
        "agent": {
          "id": "attio-task-agent-list-members",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-attio/attio:attio_list_workspace_members"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-attio/attio:attio_list_workspace_members",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-attio/attio:attio_list_workspace_members"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "trigger.payload"
        }
      },
      "selectMember": {
        "kind": "awaitSignal",
        "id": "selectMember",
        "name": "member-selection",
        "drainBehavior": "wait",
        "after": [
          "listMembers"
        ]
      },
      "listTasks": {
        "kind": "step",
        "id": "listTasks",
        "agent": {
          "id": "attio-task-agent-list-tasks",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "attio_list_tasks"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: attio_list_tasks",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "attio_list_tasks",
            "workbench.argMap": "{\"assignee\":{\"from\":\"assignee\"},\"isCompleted\":{\"literal\":false}}"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.selectMember.output"
        },
        "after": [
          "selectMember"
        ]
      },
      "selectTask": {
        "kind": "awaitSignal",
        "id": "selectTask",
        "name": "task-selection",
        "drainBehavior": "wait",
        "after": [
          "listTasks"
        ]
      },
      "fetchTask": {
        "kind": "step",
        "id": "fetchTask",
        "agent": {
          "id": "attio-task-agent-fetch-task",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "attio_get_task"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: attio_get_task",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "attio_get_task",
            "workbench.argMap": "{\"taskId\":{\"from\":\"taskId\"}}"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.selectTask.output"
        },
        "after": [
          "selectTask"
        ]
      },
      "analyze": {
        "kind": "step",
        "id": "analyze",
        "agent": {
          "id": "attio-task-agent-analyze",
          "systemPrompt": "You are a business-development task agent. You are given one Attio task and its linked record (a company or person).\n\nYour job this turn is to GATHER enough context to complete the task, then DECIDE whether you can proceed.\n\n## Grounding\nUse your read-only tools to ground yourself before deciding. Prefer, in order:\n- The Attio task and its linked record (already provided; fetch more with attio_get_record / attio_query_records / attio_search_records if useful).\n- Internal knowledge: granola_get_note / granola_list_notes for call context, artifact_read / artifact_find_by_title / artifact_list for prior collateral.\n- The web via exa_search for public company/person facts.\nGather aggressively and autonomously — only stop to ask the human when a genuine blocker remains.\n\n## Decide\nReturn ONLY a JSON object matching this shape (no prose, no code fence):\n{\n  \"status\": \"ready\" | \"need_clarification\" | \"need_more_context\",\n  \"reasoning\": string,                       // one or two sentences\n  \"questions\"?: string[],                    // REQUIRED when status is need_clarification\n  \"selectedArtifactKinds\"?: [{ \"kind\": string }],  // objects; choose the relevant subset of: cold-email, follow-up-email, twitter-post, linkedin-post, research-brief, task-explanation, gamma-presentation, blog, single-page-website\n  \"proposedTaskUpdate\"?: { \"markComplete\"?: boolean, \"note\"?: string }\n}\n\n- status=ready: you have enough to generate. Populate selectedArtifactKinds with the kinds that fit THIS task (do not select all of them by default).\n- status=need_clarification: you are blocked on something only the human knows. Put crisp, specific questions in questions[].\n- status=need_more_context: you could not gather enough from tools but no human input is needed; the run will still proceed best-effort.\n- proposedTaskUpdate: if the task should be marked done and/or a note attached to the record once the human approves, propose it here.",
          "toolFactories": [],
          "capabilities": [
            "attio_get_task",
            "@workbench/tools-attio/attio:attio_get_record",
            "@workbench/tools-attio/attio:attio_query_records",
            "@workbench/tools-attio/attio:attio_search_records",
            "@workbench/tools-attio/attio:attio_list_objects",
            "@workbench/tools-attio/attio:attio_list_workspace_members",
            "@workbench/tools-granola/granola:granola_list_notes",
            "@workbench/tools-granola/granola:granola_get_note",
            "@workbench/tools-exa/exa:exa_search",
            "@workbench/tools-artifact/artifact:artifact_read",
            "@workbench/tools-artifact/artifact:artifact_list",
            "@workbench/tools-artifact/artifact:artifact_find_by_title"
          ],
          "inference": {
            "sources": [
              {
                "provider": "openai-compatible",
                "model": "deepseek-v4-flash"
              }
            ]
          },
          "description": "Grounds itself in the Attio task + record and internal context (read-only), then decides whether it can proceed.",
          "tags": {
            "credentialName": "opencode-zen"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.fetchTask.output"
            },
            {
              "from": "steps.selectTask.output"
            }
          ]
        },
        "after": [
          "fetchTask"
        ]
      },
      "clarify": {
        "kind": "awaitSignal",
        "id": "clarify",
        "name": "clarification",
        "drainBehavior": "wait",
        "after": [
          "analyze"
        ]
      },
      "generate": {
        "kind": "map",
        "id": "generate",
        "over": {
          "from": "steps.analyze.output.selectedArtifactKinds"
        },
        "step": {
          "kind": "step",
          "id": "",
          "agent": {
            "id": "attio-task-agent-generate-one",
            "systemPrompt": "You are a business-development writer. Given an Attio task, its record context, the prior analysis decision, any human clarifications, and a single target artifact kind (the input's top-level `kind` field), produce exactly ONE artifact of that kind.\n\nHonor these rules by kind:\n- Emails (cold-email, follow-up-email): ready to send, specific to the record; no placeholders.\n- Social posts (twitter-post, linkedin-post): ANONYMIZED — no company names, personal names, or identifying details.\n- research-brief: grounded, cited where possible, skimmable.\n- task-explanation: restate the task with full context and rationale.\n- gamma-presentation: a deck outline (titled slides with bullet content).\n- blog: long-form post.\n- single-page-website: copy + section structure for a landing page.\n\nReturn ONLY a JSON object (no prose, no code fence):\n{\n  \"kind\": string, \"title\": string, \"content\": string\n}\nkind MUST equal the target kind you were given. Do not invent kinds.",
            "toolFactories": [],
            "capabilities": [],
            "inference": {
              "sources": [
                {
                  "provider": "openai-compatible",
                  "model": "kimi-k2.6",
                  "parameters": {
                    "maxTokens": 16384
                  }
                }
              ]
            },
            "description": "Inline single-turn inference: attio-task-agent-generate-one",
            "tags": {
              "workbench.stepKind": "inline-inference"
            }
          },
          "drainBehavior": "cancel",
          "input": {
            "merge": [
              {
                "from": "steps.fetchTask.output"
              },
              {
                "from": "steps.analyze.output"
              },
              {
                "from": "steps.clarify.output"
              },
              {
                "from": "trigger.payload"
              }
            ]
          }
        },
        "after": [
          "clarify"
        ]
      },
      "review": {
        "kind": "awaitSignal",
        "id": "review",
        "name": "review",
        "drainBehavior": "wait",
        "after": [
          "generate"
        ]
      },
      "persist": {
        "kind": "map",
        "id": "persist",
        "over": {
          "from": "steps.review.output.approvedPieces"
        },
        "step": {
          "kind": "step",
          "id": "",
          "agent": {
            "id": "attio-task-agent-persist",
            "systemPrompt": "",
            "toolFactories": [],
            "capabilities": [
              "@workbench/tools-artifact/artifact:artifact_create"
            ],
            "inference": {
              "sources": []
            },
            "description": "Deterministic tool call: @workbench/tools-artifact/artifact:artifact_create",
            "tags": {
              "workbench.stepKind": "deterministic-tool",
              "workbench.tool": "@workbench/tools-artifact/artifact:artifact_create",
              "workbench.argMap": "{\"title\":{\"from\":\"title\"},\"kind\":{\"from\":\"kind\"},\"content\":{\"from\":\"content\"}}"
            }
          },
          "drainBehavior": "cancel",
          "input": {
            "from": "trigger.payload"
          }
        },
        "after": [
          "review"
        ]
      },
      "suggest": {
        "kind": "step",
        "id": "suggest",
        "agent": {
          "id": "attio-task-agent-suggest",
          "systemPrompt": "You are a business-development task agent wrapping up. Given the Attio task, its context, and the analysis decision, write a short completion summary for the human.\n\nCover: what you produced, and 2-4 concrete suggested follow-ups (next BD actions) if any.\n\nWhen a follow-up maps to an existing Workbench workflow, recommend running it by name:\n- \"Gamma Presentation Creator\" — turn the collateral into a deck.\n- \"last30days Research\" — deeper recent research on the company/person.\n- \"Pain Point Collateral Generation\" — mine a call transcript for pain points and generate collateral.\nOnly suggest a workflow when it genuinely fits the task; do not list them all by default.\n\nKeep it to a few sentences plus a short bulleted list. Plain text, no code fence.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": []
          },
          "description": "Inline single-turn inference: attio-task-agent-suggest",
          "tags": {
            "workbench.stepKind": "inline-inference"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.fetchTask.output"
            },
            {
              "from": "steps.analyze.output"
            }
          ]
        },
        "after": [
          "persist"
        ]
      },
      "approveSync": {
        "kind": "awaitSignal",
        "id": "approveSync",
        "name": "sync-approval",
        "drainBehavior": "wait",
        "after": [
          "suggest"
        ]
      },
      "syncGate": {
        "kind": "gate",
        "id": "syncGate",
        "when": {
          "from": "steps.approveSync.output.confirm"
        },
        "then": "writeNote",
        "else": "skipWriteBack",
        "after": [
          "approveSync"
        ]
      },
      "writeNote": {
        "kind": "step",
        "id": "writeNote",
        "agent": {
          "id": "attio-task-agent-write-note",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "attio_create_note"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: attio_create_note",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "attio_create_note",
            "workbench.argMap": "{\"parentObject\":{\"from\":\"parentObject\"},\"parentRecordId\":{\"from\":\"parentRecordId\"},\"content\":{\"from\":\"note\"}}"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.approveSync.output"
        },
        "after": [
          "syncGate"
        ]
      },
      "writeComplete": {
        "kind": "step",
        "id": "writeComplete",
        "agent": {
          "id": "attio-task-agent-write-complete",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "attio_update_task"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: attio_update_task",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "attio_update_task",
            "workbench.argMap": "{\"taskId\":{\"from\":\"taskId\"},\"isCompleted\":{\"literal\":true}}"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.approveSync.output"
        },
        "after": [
          "writeNote"
        ]
      },
      "skipWriteBack": {
        "kind": "step",
        "id": "skipWriteBack",
        "agent": {
          "id": "attio-task-agent-skip-writeback",
          "systemPrompt": "Reply with exactly: skipped. Output nothing else.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": []
          },
          "description": "Inline single-turn inference: attio-task-agent-skip-writeback",
          "tags": {
            "workbench.stepKind": "inline-inference"
          }
        },
        "drainBehavior": "cancel",
        "after": [
          "syncGate"
        ],
        "input": {
          "from": "steps.syncGate.output"
        }
      }
    },
    "stepOrder": [
      "listMembers",
      "selectMember",
      "listTasks",
      "selectTask",
      "fetchTask",
      "analyze",
      "clarify",
      "generate",
      "review",
      "persist",
      "suggest",
      "approveSync",
      "syncGate",
      "writeNote",
      "writeComplete",
      "skipWriteBack"
    ]
  }
}
