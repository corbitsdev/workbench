      "gen-cold-email": {
        "kind": "step",
        "id": "gen-cold-email",
        "agent": {
          "id": "attio-task-agent-gen-cold-email",
          "systemPrompt": "You are a business-development writer. Your input carries an Attio task, its linked record context, the prior analysis decision, and any human clarifications.\n\nWrite a first-touch cold outreach email to the task's contact.\nSubject + body. Open with a specific, researched reason for reaching out (not a generic hook). One clear ask. 90-130 words. Ready to send — no placeholders or [brackets]. Warm, direct, peer-to-peer; no hype.\n\nReturn ONLY a JSON object (no prose, no code fence):\n{\n  \"kind\": \"cold-email\", \"title\": string, \"content\": string\n}",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": [
              {
                "provider": "openai-compatible",
                "model": "kimi-k2.6",
                "parameters": {
                  "maxTokens": 16384
                }
              }
            ]
          },
          "description": "Inline single-turn inference: attio-task-agent-gen-cold-email",
          "tags": {
            "workbench.stepKind": "inline-inference"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.fetchTask.output"
            },
            {
              "from": "steps.analyze.output"
            },
            {
              "from": "steps.clarify.output"
            }
          ]
        },
        "after": [
          "gate-cold-email"
