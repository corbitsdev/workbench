{
  "kind": "firecrawl-url-watch",
  "version": "0.1.0",
  "label": "Website URL watch",
  "description": "On a schedule, scrape a URL with Firecrawl and save a short change/summary digest artifact.",
  "requiresIntake": true,
  "humanGateCount": 1,
  "intakeFields": [
    {
      "name": "url",
      "label": "URL",
      "inputHint": "url",
      "required": true,
      "help": "Page to scrape each run.",
      "placeholder": "https://example.com/pricing",
      "order": 0
    },
    {
      "name": "focus",
      "label": "Watch focus",
      "inputHint": "text",
      "required": false,
      "help": "Optional: what to pay attention to (pricing, changelog, blog, etc.).",
      "placeholder": "pricing changes",
      "order": 1
    }
  ],
  "definition": {
    "id": "firecrawl-url-watch",
    "triggers": [
      {
        "type": "manual"
      }
    ],
    "steps": {
      "intake": {
        "kind": "awaitSignal",
        "id": "intake",
        "name": "intake",
        "drainBehavior": "wait"
      },
      "fetch": {
        "kind": "action",
        "id": "fetch",
        "handler": "@workbench/tools-firecrawl/firecrawl:firecrawl_scrape",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.intake.output"
            },
            {
              "literal": {
                "onlyMainContent": true
              }
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-firecrawl/firecrawl:firecrawl_scrape"
          ]
        },
        "after": [
          "intake"
        ]
      },
      "digest": {
        "kind": "step",
        "id": "digest",
        "agent": {
          "id": "firecrawl-url-watch-digest",
          "systemPrompt": "Treat Corbits, Corbits.dev, Interchange, and Faremeter as canonical Corbits names; spell them exactly. When source material contains a clear speech-to-text or spelling variant, use the canonical spelling in your output. Do not replace an ambiguous term unless surrounding context identifies it.\n\nYou write short unattended website-watch digests for a scheduled scrape.\n\nYou receive the URL, optional focus, and Firecrawl scrape output (markdown/main content).\n\nWrite a concise markdown digest:\n1. One-line summary of the page state\n2. Key sections or claims relevant to the focus (or overall if no focus)\n3. Anything that looks new, promotional, or decision-relevant\n4. \"Watch next time\" — 1–3 things to re-check on the next scrape\n\nNo preamble. No tool calls. Markdown body only.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": []
          },
          "description": "Reasoning step: firecrawl-url-watch-digest",
          "tags": {
            "workbench.title": "Write the digest"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.intake.output"
            },
            {
              "from": "steps.fetch.output"
            }
          ]
        },
        "after": [
          "fetch"
        ]
      },
      "document": {
        "kind": "action",
        "id": "document",
        "handler": "@workbench/tools-firecrawl-url-watch/core:firecrawl_url_watch_format_document",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.intake.output"
            },
            {
              "from": "steps.digest.output"
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-firecrawl-url-watch/core:firecrawl_url_watch_format_document"
          ]
        },
        "after": [
          "digest"
        ]
      },
      "persist": {
        "kind": "action",
        "id": "persist",
        "handler": "@workbench/tools-artifact/artifact:write_artifact",
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.document.output.content"
            },
            {
              "literal": {
                "kind": "research",
                "jobLabel": "Website URL watch"
              }
            }
          ]
        },
        "effect": {
          "requires": [
            "@workbench/tools-artifact/artifact:write_artifact"
          ]
        },
        "after": [
          "document"
        ]
      }
    },
    "stepOrder": [
      "intake",
      "fetch",
      "digest",
      "document",
      "persist"
    ]
  }
}
