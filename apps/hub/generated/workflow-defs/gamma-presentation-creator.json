{
  "kind": "gamma-presentation-creator",
  "version": "0.1.0",
  "label": "Gamma Presentation Creator",
  "description": "Turn any artifact, call, or pasted text into a Gamma deck, refining it round by round until you approve it.",
  "definition": {
    "id": "gamma-presentation-creator",
    "triggers": [
      {
        "type": "manual"
      }
    ],
    "steps": {
      "list-artifacts": {
        "kind": "step",
        "id": "list-artifacts",
        "agent": {
          "id": "presentation-list-artifacts",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-artifact/artifact:artifact_list"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-artifact/artifact:artifact_list",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-artifact/artifact:artifact_list",
            "workbench.argMap": "{\"limit\":{\"literal\":50}}",
            "workbench.title": "List your artifacts"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "trigger.payload"
        }
      },
      "list-notes": {
        "kind": "step",
        "id": "list-notes",
        "agent": {
          "id": "presentation-list-notes",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-granola/granola:granola_list_notes"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-granola/granola:granola_list_notes",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-granola/granola:granola_list_notes",
            "workbench.argMap": "{\"limit\":{\"literal\":30}}",
            "workbench.title": "List your call notes"
          }
        },
        "drainBehavior": "cancel"
      },
      "intake": {
        "kind": "awaitSignal",
        "id": "intake",
        "name": "intake",
        "drainBehavior": "wait",
        "after": [
          "list-artifacts",
          "list-notes"
        ]
      },
      "fetch-artifact": {
        "kind": "step",
        "id": "fetch-artifact",
        "agent": {
          "id": "presentation-fetch-artifact",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-artifact/artifact:artifact_read"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-artifact/artifact:artifact_read",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-artifact/artifact:artifact_read",
            "workbench.argMap": "{\"artifactId\":{\"from\":\"artifactId\"}}",
            "workbench.nonFatal": "true",
            "workbench.title": "Load the chosen artifact"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.intake.output"
        },
        "after": [
          "intake"
        ]
      },
      "fetch-note": {
        "kind": "step",
        "id": "fetch-note",
        "agent": {
          "id": "presentation-fetch-note",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-granola/granola:granola_get_note"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-granola/granola:granola_get_note",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-granola/granola:granola_get_note",
            "workbench.argMap": "{\"noteId\":{\"from\":\"noteId\"}}",
            "workbench.nonFatal": "true",
            "workbench.title": "Load the chosen note"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.intake.output"
        },
        "after": [
          "intake"
        ]
      },
      "generate-1": {
        "kind": "step",
        "id": "generate-1",
        "agent": {
          "id": "presentation-generate-1",
          "systemPrompt": "You write slide content for branded Gamma presentations. You are given a brief and a source, and you produce slide-by-slide content for a deck.\n\nThe source is one of: an artifact's content, a call note's content, or pasted text carried on the brief. The reader for a source that was not used for this run degrades to an error envelope (an object with \"isError\": true and an error message in \"content\") — ignore any such envelope and use only the real source.\n\nIf a previous draft and reviewer feedback are present in the input, REVISE the previous draft to address the feedback. Keep what worked, change what the feedback asks for, and do not start over from scratch.\n\nVoice and brand:\n- Direct and confident. No corporate superlatives (\"best in class\", \"revolutionary\", \"cutting-edge\"), no opener padding (\"We're excited to announce\"), no filler slides.\n- No em dashes — rewrite the sentence instead. No hashtags.\n- The customer and their problem are the hero, never Corbits.\n- Open with the tension or question the audience already has, not a claim.\n- Use \"workbench\", never \"workspace\".\n- Match the requested audience, tone, and goal.\n\nFormat each slide as:\nSLIDE N: [Title]\n[Content - 2-5 sentences or a clean list, no padding]\n\nProduce the number of slides appropriate for the brief.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": []
          },
          "description": "Inline single-turn inference: presentation-generate-1",
          "tags": {
            "workbench.stepKind": "inline-inference",
            "workbench.title": "Draft the deck"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.intake.output"
            },
            {
              "from": "steps.fetch-artifact.output"
            },
            {
              "from": "steps.fetch-note.output"
            }
          ]
        },
        "after": [
          "fetch-artifact",
          "fetch-note"
        ]
      },
      "render-1": {
        "kind": "step",
        "id": "render-1",
        "agent": {
          "id": "presentation-render-1",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-gamma/gamma:gamma_create_from_template"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-gamma/gamma:gamma_create_from_template",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-gamma/gamma:gamma_create_from_template",
            "workbench.argMap": "{\"gammaId\":{\"from\":\"gammaId\"},\"prompt\":{\"from\":\"reply\"}}",
            "workbench.title": "Build the deck in Gamma"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.intake.output"
            },
            {
              "from": "steps.generate-1.output"
            }
          ]
        },
        "after": [
          "generate-1"
        ]
      },
      "describe-1": {
        "kind": "step",
        "id": "describe-1",
        "agent": {
          "id": "presentation-describe-1",
          "systemPrompt": "You are given the slide content of a Gamma deck. Write ONE sentence describing what the deck is, for a listing next to the deck link.\n\n- One sentence, under 160 characters. No preamble, no \"This deck\", no quotes.\n- Name the subject and the point of the deck, not the slide structure.\n- Use \"workbench\", never \"workspace\". No em dashes, no hashtags, no corporate superlatives.\n\nOutput only the sentence.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": [
              {
                "provider": "openai-compatible",
                "model": "deepseek-v4-flash"
              }
            ]
          },
          "description": "Inline single-turn inference: presentation-describe-1",
          "tags": {
            "workbench.stepKind": "inline-inference",
            "workbench.title": "Summarize the deck"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.generate-1.output"
        },
        "after": [
          "generate-1"
        ]
      },
      "preview-1": {
        "kind": "awaitSignal",
        "id": "preview-1",
        "name": "preview-1",
        "drainBehavior": "wait",
        "after": [
          "render-1"
        ]
      },
      "persist-1": {
        "kind": "step",
        "id": "persist-1",
        "agent": {
          "id": "presentation-persist-1",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-artifact/artifact:artifact_link_gamma_presentation"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-artifact/artifact:artifact_link_gamma_presentation",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-artifact/artifact:artifact_link_gamma_presentation",
            "workbench.argMap": "{\"title\":{\"from\":\"deckTitle\"},\"url\":{\"from\":\"gammaUrl\"},\"description\":{\"from\":\"reply\"},\"gammaId\":{\"from\":\"gammaId\"},\"pdfUrl\":{\"from\":\"exportUrl\"}}",
            "workbench.title": "Save the deck"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.intake.output"
            },
            {
              "from": "steps.render-1.output"
            },
            {
              "from": "steps.describe-1.output"
            }
          ]
        },
        "after": [
          "check-1",
          "describe-1"
        ]
      },
      "check-1": {
        "kind": "gate",
        "id": "check-1",
        "when": {
          "from": "steps.preview-1.output.approved"
        },
        "then": "persist-1",
        "else": "generate-2",
        "after": [
          "preview-1"
        ]
      },
