{
  "kind": "gamma-presentation-creator",
  "version": "0.1.0",
  "label": "Gamma Presentation Creator",
  "description": "Turn any artifact, call, or pasted text into a Gamma deck.",
  "displayFlow": [
    {
      "key": "source",
      "label": "Source",
      "stepIds": [
        "list-artifacts",
        "list-notes",
        "intake",
        "fetch-artifact",
        "fetch-note"
      ]
    },
    {
      "key": "draft",
      "label": "Draft",
      "stepIds": [
        "generate",
        "render"
      ],
      "activityLabel": "Building the deck"
    },
    {
      "key": "done",
      "label": "Done",
      "stepIds": [
        "persist"
      ],
      "activityLabel": "Saving to workbench"
    }
  ],
  "requiresIntake": true,
  "humanGateCount": 1,
  "definition": {
    "id": "gamma-presentation-creator",
    "triggers": [
      {
        "type": "manual"
      }
    ],
    "steps": {
      "list-artifacts": {
        "kind": "step",
        "id": "list-artifacts",
        "agent": {
          "id": "presentation-list-artifacts",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-artifact/artifact:artifact_list"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-artifact/artifact:artifact_list",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-artifact/artifact:artifact_list",
            "workbench.argMap": "{\"limit\":{\"literal\":50}}",
            "workbench.title": "List your artifacts"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "trigger.payload"
        }
      },
      "list-notes": {
        "kind": "step",
        "id": "list-notes",
        "agent": {
          "id": "presentation-list-notes",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-granola/granola:granola_list_notes"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-granola/granola:granola_list_notes",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-granola/granola:granola_list_notes",
            "workbench.argMap": "{\"limit\":{\"literal\":30}}",
            "workbench.title": "List your call notes"
          }
        },
        "drainBehavior": "cancel"
      },
      "intake": {
        "kind": "awaitSignal",
        "id": "intake",
        "name": "intake",
        "drainBehavior": "wait",
        "after": [
          "list-artifacts",
          "list-notes"
        ]
      },
      "fetch-artifact": {
        "kind": "step",
        "id": "fetch-artifact",
        "agent": {
          "id": "presentation-fetch-artifact",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-artifact/artifact:artifact_read"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-artifact/artifact:artifact_read",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-artifact/artifact:artifact_read",
            "workbench.argMap": "{\"artifactId\":{\"from\":\"artifactId\",\"skipStepIfAbsent\":true}}",
            "workbench.nonFatal": "true",
            "workbench.title": "Load the chosen artifact"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.intake.output"
        },
        "after": [
          "intake"
        ]
      },
      "fetch-note": {
        "kind": "step",
        "id": "fetch-note",
        "agent": {
          "id": "presentation-fetch-note",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-granola/granola:granola_get_note"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-granola/granola:granola_get_note",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-granola/granola:granola_get_note",
            "workbench.argMap": "{\"noteId\":{\"from\":\"noteId\",\"skipStepIfAbsent\":true}}",
            "workbench.nonFatal": "true",
            "workbench.title": "Load the chosen note"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.intake.output"
        },
        "after": [
          "intake"
        ]
      },
      "generate": {
        "kind": "step",
        "id": "generate",
        "agent": {
          "id": "presentation-generate",
          "systemPrompt": "Treat Corbits, Corbits.dev, Interchange, and Faremeter as canonical Corbits names; spell them exactly. When source material contains a clear speech-to-text or spelling variant, use the canonical spelling in your output. Do not replace an ambiguous term unless surrounding context identifies it.\n\nYou write slide content for branded Gamma presentations. You are given a brief and a source, and you produce slide-by-slide content for a deck.\n\nThe source is one of: an artifact's content, a call note's content, or pasted text carried on the brief. The reader for a source that was not used for this run degrades to an error envelope (an object with \"isError\": true and an error message in \"content\") — ignore any such envelope and use only the real source.\n\nIf the input contains a non-empty \"templateSystemPrompt\" field, it is additional template-specific authoring guidance from the selected Gamma template — follow it in addition to the base rules below.\n\nVoice and brand:\n- Direct and confident. No corporate superlatives (\"best in class\", \"revolutionary\", \"cutting-edge\"), no opener padding (\"We're excited to announce\"), no filler slides.\n- No em dashes — rewrite the sentence instead. No hashtags.\n- The customer and their problem are the hero, never Corbits.\n- Open with the tension or question the audience already has, not a claim.\n- Use \"workbench\", never \"workspace\".\n- Match the requested audience, tone, and goal.\n\nFormat each slide as:\nSLIDE N: [Title]\n[Content - 2-5 sentences or a clean list, no padding]\n\nProduce the number of slides appropriate for the brief.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": []
          },
          "description": "Reasoning step: presentation-generate",
          "tags": {
            "workbench.title": "Draft the deck"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.intake.output"
            },
            {
              "from": "steps.fetch-artifact.output"
            },
            {
              "from": "steps.fetch-note.output"
            }
          ]
        },
        "after": [
          "fetch-artifact",
          "fetch-note"
        ]
      },
      "render": {
        "kind": "step",
        "id": "render",
        "agent": {
          "id": "presentation-render",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-gamma/gamma:gamma_create_from_template"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-gamma/gamma:gamma_create_from_template",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-gamma/gamma:gamma_create_from_template",
            "workbench.argMap": "{\"gammaId\":{\"from\":\"gammaId\"},\"prompt\":{\"from\":\"reply\"}}",
            "workbench.title": "Build the deck in Gamma"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.intake.output"
            },
            {
              "from": "steps.generate.output"
            }
          ]
        },
        "after": [
          "generate"
        ]
      },
      "describe": {
        "kind": "step",
        "id": "describe",
        "agent": {
          "id": "presentation-describe",
          "systemPrompt": "Treat Corbits, Corbits.dev, Interchange, and Faremeter as canonical Corbits names; spell them exactly. When source material contains a clear speech-to-text or spelling variant, use the canonical spelling in your output. Do not replace an ambiguous term unless surrounding context identifies it.\n\nYou are given the slide content of a Gamma deck. Write ONE sentence describing what the deck is, for a listing next to the deck link.\n\n- One sentence, under 160 characters. No preamble, no \"This deck\", no quotes.\n- Name the subject and the point of the deck, not the slide structure.\n- Use \"workbench\", never \"workspace\". No em dashes, no hashtags, no corporate superlatives.\n\nOutput only the sentence.",
          "toolFactories": [],
          "capabilities": [],
          "inference": {
            "sources": [
              {
                "provider": "openai-compatible",
                "model": "deepseek-v4-flash"
              }
            ]
          },
          "description": "Reasoning step: presentation-describe",
          "tags": {
            "workbench.title": "Summarize the deck"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "from": "steps.generate.output"
        },
        "after": [
          "generate"
        ]
      },
      "persist": {
        "kind": "step",
        "id": "persist",
        "agent": {
          "id": "presentation-persist",
          "systemPrompt": "",
          "toolFactories": [],
          "capabilities": [
            "@workbench/tools-artifact/artifact:artifact_link_gamma_presentation"
          ],
          "inference": {
            "sources": []
          },
          "description": "Deterministic tool call: @workbench/tools-artifact/artifact:artifact_link_gamma_presentation",
          "tags": {
            "workbench.stepKind": "deterministic-tool",
            "workbench.tool": "@workbench/tools-artifact/artifact:artifact_link_gamma_presentation",
            "workbench.argMap": "{\"title\":{\"from\":\"deckTitle\"},\"description\":{\"from\":\"reply\"},\"url\":{\"fromJson\":\"content\",\"field\":\"gammaUrl\"},\"gammaId\":{\"fromJson\":\"content\",\"field\":\"gammaId\"},\"pdfUrl\":{\"fromJson\":\"content\",\"field\":\"exportUrl\"}}",
            "workbench.title": "Save the deck"
          }
        },
        "drainBehavior": "cancel",
        "input": {
          "merge": [
            {
              "from": "steps.intake.output"
            },
            {
              "from": "steps.render.output"
            },
            {
              "from": "steps.describe.output"
            }
          ]
        },
        "after": [
          "render",
          "describe"
        ]
      }
    },
    "stepOrder": [
      "list-artifacts",
      "list-notes",
      "intake",
      "fetch-artifact",
      "fetch-note",
      "generate",
      "render",
      "describe",
      "persist"
    ]
  }
}
