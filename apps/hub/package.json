{
  "name": "@workbench/hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build:workflow-defs": "bun run bin/build-workflow-defs.ts",
    "build:tool-manifests": "bun run bin/build-tool-manifests.ts",
    "build": "bun run build:workflow-defs && bun run build:tool-manifests && bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "start": "bun run dist/index.js",
    "test": "bun test --isolate",
    "test:workflow-e2e": "bun test --isolate src/services/workflow-regression-gate.integration.test.ts",
    "test:coverage": "bun test --isolate --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "admin": "bun --env-file=../../.env run bin/admin/index.ts",
    "admin:staging": "bun --env-file=../../.env.staging run bin/admin/index.ts",
    "admin:production": "bun --env-file=../../.env.production run bin/admin/index.ts",
    "audit-tenancy:staging": "bun --env-file=../../.env.staging run bin/audit-tenancy.ts",
    "audit-tenancy:production": "bun --env-file=../../.env.production run bin/audit-tenancy.ts",
    "audit-tenancy": "bun --env-file=../../.env run bin/audit-tenancy.ts",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.9",
    "@intx/agent": "workspace:*",
    "@intx/authz": "workspace:*",
    "@intx/crypto": "workspace:*",
    "@intx/db": "workspace:*",
    "@intx/hub-api": "workspace:*",
