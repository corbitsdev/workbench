    "@corbits/mailbox": "0.2.1",
    "@corbits/mcp": "^0.3.1",
    "@corbits/memory": "0.2.1",
    "@corbits/oauth-core": "^0.3.2",
    "@corbits/webhooks": "0.3.2",
    "@corbits/xai-provider": "0.1.3",
    "@intx/authz": "workspace:*",
    "@intx/crypto": "0.5.0",
    "@intx/db": "workspace:*",
    "@intx/hub-api": "workspace:*",
