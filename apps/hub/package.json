{
  "name": "@workbench/hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "seed:superadmin": "bun --env-file=../../.env run bin/seed.ts",
    "seed:superadmin-prod": "bun run bin/seed-prod.ts",
    "seed:llm-credential": "bun --env-file=../../.env run bin/add-llm-credential.ts",
    "seed:credentials": "bun --env-file=../../.env run bin/seed-credentials.ts",
    "diagnose:providers": "bun --env-file=../../.env run bin/diagnose-providers.ts",
    "reset:myra": "bun --env-file=../../.env run bin/reset-myra.ts",
    "workbench:create": "bun --env-file=../../.env run bin/create-workbench.ts",
    "workbench:members": "bun --env-file=../../.env run bin/manage-workbench-members.ts",
    "workbench:remove-member": "bun --env-file=../../.env run bin/remove-workbench-member.ts",
    "build:tool-packages": "bun run bin/build-tool-packages.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.9",
    "@intx/agent": "workspace:*",
    "@intx/authz": "workspace:*",
    "@intx/crypto-node": "workspace:*",
    "@intx/db": "workspace:*",
    "@intx/hub-api": "workspace:*",
    "@intx/hub-common": "workspace:*",
    "@intx/hub-sessions": "workspace:*",
    "@intx/inference": "workspace:*",
    "@intx/log": "workspace:*",
    "@intx/storage-isogit": "workspace:*",
    "@intx/tools-mail": "workspace:*",
    "@intx/tools-posix": "workspace:*",
    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*",
    "@intx/workflow-deploy": "workspace:*",
    "@workbench/agents": "workspace:*",
    "@workbench/event-collector": "workspace:*",
    "@workbench/gtm-workflows": "workspace:*",
    "@workbench/last30days-core": "workspace:*",
    "@workbench/sentry": "workspace:*",
    "@workbench/shared": "workspace:*",
    "@workbench/tool-credentials": "workspace:*",
    "@workbench/tools-agents": "workspace:*",
    "@workbench/tools-artifact": "workspace:*",
    "@workbench/tools-bluesky": "workspace:*",
    "@workbench/tools-dispatch": "workspace:*",
    "@workbench/tools-exa": "workspace:*",
    "@workbench/tools-firecrawl": "workspace:*",
    "@workbench/tools-gamma": "workspace:*",
    "@workbench/tools-github": "workspace:*",
    "@workbench/tools-granola": "workspace:*",
    "@workbench/tools-hackernews": "workspace:*",
    "@workbench/tools-last30days": "workspace:*",
    "@workbench/tools-polymarket": "workspace:*",
    "@workbench/tools-reddit": "workspace:*",
    "@workbench/tools-scrapecreators": "workspace:*",
    "@workbench/tools-x": "workspace:*",
    "@workbench/tools-youtube": "workspace:*",
    "arktype": "catalog:",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.10.7",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/ssri": "^7.1.5",
    "drizzle-kit": "^0.31.1",
    "exceljs": "^4.4.0",
    "ssri": "^12.0.0",
    "tar": "^7.5.1",
    "typescript": "^5.9.0"
  }
}
