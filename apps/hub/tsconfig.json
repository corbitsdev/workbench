{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "@workbench/shared": ["../../packages/workbench-shared/src/index.ts"],
      "@workbench/agent-scheduler": ["../../packages/agent-scheduler/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
