{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext"
    ],
    "types": [
      "bun"
    ],
    "paths": {
      "@workbench/shared": [
        "../../packages/workbench-shared/src/index.ts"
      ],
      "@intx/hub-client": [
        "./src/intx-hub-client-server.ts"
      ]
    },
    "customConditions": [
      "intx-src"
    ]
  },
  "include": [
    "src/**/*"
  ]
}
