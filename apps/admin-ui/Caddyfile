# Railway injects PORT; default to 80 for local `docker run`.
# HUB_URL must be set to the hub service origin (e.g. https://hub.example.com).
# /api/* and /api/sse/* are proxied to the hub for same-origin auth cookies and SSE.
:{$PORT:80} {
	reverse_proxy /api/* {$HUB_URL}
	root * /usr/share/caddy
	encode gzip
	# SPA fallback: unknown paths resolve to index.html for client-side routing.
	try_files {path} /index.html
	file_server
}
