{
  "name": "@workbench/sidecar",
  "version": "0.3.0",
  "private": true,
  "description": "Host process running a fleet of hub-orchestrated agent runtimes in one Bun process",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "bin": {
    "workflow-child": "./bin/workflow-child"
  },
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@corbits/credential-header": "github:corbitsdev/corbits-credential-header#eee7b7eb79755fd1ddc3eb2b9a57c4e50982e293",
    "@corbits/credential-mcp": "github:corbitsdev/corbits-credential-mcp#fb9ec3a6754348cd33c388c70c0830b8844c83de",
    "@intx/agent": "workspace:*",
    "@intx/authz": "0.3.0",
    "@intx/crypto": "0.3.0",
    "@intx/harness": "workspace:*",
    "@intx/hub-agent": "workspace:*",
    "@intx/hub-sessions": "workspace:*",
    "@intx/inference": "workspace:*",
    "@intx/log": "0.3.0",
    "@intx/mail-memory": "workspace:*",
    "@intx/pack-transport": "0.3.0",
    "@intx/storage-isogit": "0.3.0",
    "@intx/tool-packaging": "0.3.0",
    "@intx/tools-lsp": "0.3.0",
    "@intx/tools-mail": "0.3.0",
    "@intx/tools-posix": "0.3.0",
    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*",
    "@intx/workflow-deploy": "workspace:*",
    "@intx/workflow-host": "workspace:*",
    "arktype": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "isomorphic-git": "catalog:",
    "typescript": "catalog:"
  }
}
