{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ESNext"
    ],
    "types": [
      "bun"
    ],
    "paths": {
      "@intx/hub-client": [
        "./src/intx-hub-client-server.ts"
      ]
    },
    "customConditions": [
      "intx-src"
    ]
  },
  "include": [
    "src/**/*"
  ]
}
