{
  "name": "@workbench/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "bun test --path-ignore-patterns='**/use-workflow.test.tsx' src && bun test src/hooks/use-workflow.test.tsx",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text --path-ignore-patterns='**/use-workflow.test.tsx' src && bun test --coverage --coverage-reporter=lcov --coverage-reporter=text src/hooks/use-workflow.test.tsx"
  },
