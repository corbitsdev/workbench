{
  "name": "@workbench/web",
  "version": "0.0.1",
  "private": true,
  "description": "Single-page interface for the workbench: every page and route lives here, composed from the published component library, and builds to a static bundle the hub serves from its own origin (point HUB_STATIC_DIR at apps/web/dist)",
  "license": "SEE LICENSE IN ../../LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/corbitsdev/workbench"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "bun run build && bun test ./src"
  },
  "dependencies": {
    "@corbits/approvals": "workspace:*",
    "@corbits/credential-mcp": "github:corbitsdev/corbits-credential-mcp#fb9ec3a6754348cd33c388c70c0830b8844c83de",
    "@corbits/error-sink": "workspace:*",
    "@corbits/mcp": "github:corbitsdev/corbits-mcp#9df1ab81d2f50d798bca2d2f44eb4759c92fac0e",
    "@corbits/myra": "workspace:*",
    "@corbits/react-ui": "github:corbitsdev/react-ui#3b122812a307ccb35be31386f7696020c5a84635",
    "@corbits/url-path": "workspace:*",
    "@corbits/workflows": "workspace:*",
    "@intx/types": "workspace:*",
    "@isomorphic-git/lightning-fs": "4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "catalog:",
    "arktype": "catalog:",
    "buffer": "^6.0.3",
    "isomorphic-git": "catalog:",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-joyride": "^2.9.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.2",
    "@intx/inference": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "catalog:",
    "@types/react": "^19.2.2",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "vite": "^7.1.0"
  }
