{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "@gtm/workbench-shared": ["../../packages/workbench-shared/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
