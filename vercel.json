{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd apps/web && bunx vite build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "git submodule update --init --recursive && bun install",
  "framework": "vite",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${HUB_UPSTREAM_URL}/api/$1",
      "env": ["HUB_UPSTREAM_URL"]
    },
    {
      "src": "/sidecar/(.*)",
      "dest": "${HUB_UPSTREAM_URL}/sidecar/$1",
      "env": ["HUB_UPSTREAM_URL"]
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
