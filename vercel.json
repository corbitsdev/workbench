{
  "buildCommand": "cd apps/web && bunx vite build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "git submodule update --init --recursive && bun install && cd apps/web && CONFIGURE_VERCEL_HUB_PROXY=1 bun -e \"await import('./vite.config.ts')\"",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://corbits-workbench.up.railway.app/api/:path*"
    },
    {
      "source": "/sidecar/:path*",
      "destination": "https://corbits-workbench.up.railway.app/sidecar/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
