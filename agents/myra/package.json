{
  "name": "@corbits/myra",
  "version": "0.0.3",
  "description": "Mail-triggered conversational workflow with a general-purpose assistant agent",
  "license": "LGPL-2.1-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/corbitsdev/workbench.git",
    "directory": "agents/myra"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "bundle",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./prompt": "./src/system-prompt.ts",
    "./workflow-ids": "./src/workflow-ids.ts",
    "./bundle": "./src/bundle.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run scripts/build-bundle.ts"
  },
  "dependencies": {
    "@intx/tools-mail": "0.3.0",
    "@intx/tools-posix": "0.3.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@intx/agent": "0.3.0",
    "@intx/types": "0.3.0",
    "@intx/workflow": "0.3.0"
  },
  "corbits": {
    "workflow": {
      "assetName": "assistant",
      "displayName": "Myra",
      "automatable": false
    }
  },
  "interchange": {
    "workflow": "./src/index.ts"
  }
}
