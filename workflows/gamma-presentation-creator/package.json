{
  "name": "@workbench/workflow-gamma-presentation-creator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ui": {
      "types": "./src/ui.tsx",
      "default": "./src/ui.tsx"
    },
    "./blocks": {
      "types": "./src/blocks.ts",
      "default": "./src/blocks.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./src/test-setup.ts --isolate src",
    "test:coverage": "bun test --preload ./src/test-setup.ts --isolate --coverage --coverage-reporter=lcov --coverage-reporter=text src"
  },
  "dependencies": {
    "@intx/agent": "workspace:*",
    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*",
    "@tanstack/react-query": "5.100.14",
    "@workbench/agents": "workspace:*",
    "@workbench/blocks": "workspace:*",
    "@workbench/shared": "workspace:*",
    "@workbench/tool-credentials": "workspace:*",
    "@workbench/tool-manifest": "workspace:*",
    "@workbench/tools-artifact": "workspace:*",
    "@workbench/tools-granola": "workspace:*",
    "@workbench/ui": "workspace:*",
    "arktype": "catalog:",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@workbench/test-utils": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "*"
  },
  "interchange": {
    "tools": "./dist/interchange-tools.js",
    "manifest": "./src/tool-manifest.ts"
  }
}
