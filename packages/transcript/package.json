{
  "name": "@workbench/transcript",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "BUN_OPTIONS=--conditions=intx-src bun test --preload ./src/test-setup.ts src",
    "test:coverage": "BUN_OPTIONS=--conditions=intx-src bun test --preload ./src/test-setup.ts --coverage --coverage-reporter=lcov --coverage-reporter=text src"
  },
  "dependencies": {
    "@workbench/shared": "workspace:*",
    "@workbench/ui": "workspace:*",
    "arktype": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "framer-motion": "^12.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "framer-motion": "*",
    "react": "*"
  }
}
