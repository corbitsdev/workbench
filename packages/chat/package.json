{
  "name": "@workbench/chat",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./parts": {
      "types": "./src/parts.ts",
      "default": "./src/parts.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./src/test-setup.ts src",
    "test:coverage": "bun test --preload ./src/test-setup.ts --coverage --coverage-reporter=lcov --coverage-reporter=text src"
  },
  "dependencies": {
    "@workbench/blocks": "workspace:*",
    "@workbench/shared": "workspace:*",
    "@workbench/ui": "workspace:*",
    "arktype": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "framer-motion": "^12.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "framer-motion": "*",
    "lucide-react": "*",
    "react": "*"
  }
}
