    "@tanstack/react-query": "5.100.14",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "*",
    "react": "*"
  }
