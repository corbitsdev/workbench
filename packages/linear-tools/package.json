{
  "name": "@corbits/linear-tools",
  "description": "Linear integration: a minimal client and an @intx/agent tool bundle for listing a user's recently updated issues",
  "version": "0.1.0",
  "license": "LGPL-2.1-or-later",
  "type": "module",
  "interchange": {
    "credentials": [
      {
        "handle": "linear"
      }
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/corbitsdev/workbench.git",
    "directory": "packages/linear-tools"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "arktype": "catalog:"
  },
  "peerDependencies": {
    "@intx/agent": "0.3.0",
    "@intx/types": "0.3.0"
  },
  "devDependencies": {
    "@corbits/credential-providers": "workspace:*",
    "@intx/authz": "0.3.0",
    "@intx/crypto": "0.3.0",
    "@intx/db": "workspace:*",
    "@intx/harness": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
