{
  "name": "@workbench/hub-sessions",
  "version": "0.1.0",
  "license": "LGPL-2.1-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./substrate": {
      "types": "./src/substrate.ts",
      "default": "./src/substrate.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "BUN_OPTIONS=--conditions=intx-src bun test --isolate src",
    "test:coverage": "BUN_OPTIONS=--conditions=intx-src bun test --coverage --coverage-reporter=lcov --coverage-reporter=text"
  },
  "dependencies": {
    "@intx/agent": "workspace:*",
    "@intx/crypto": "workspace:*",
    "@intx/db": "workspace:*",
    "@intx/hub-common": "workspace:*",
    "@intx/log": "workspace:*",
    "@intx/mime": "workspace:*",
    "@intx/pack-transport": "workspace:*",
    "@intx/tool-packaging": "workspace:*",
    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*",
    "@intx/workflow-deploy": "workspace:*",
    "@workbench/storage-isogit": "workspace:*",
    "arktype": "catalog:",
    "drizzle-orm": "catalog:",
    "isomorphic-git": "catalog:",
    "tar": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "typescript": "^5.9.0"
  }
}
