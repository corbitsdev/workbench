{
  "name": "@workbench/agents",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./src/browser.ts"
    },
    "./granola-definition": {
      "types": "./src/granola/definition.ts",
      "default": "./src/granola/definition.ts"
    },
    "./prompt-builder": {
      "types": "./src/prompt-builder.ts",
      "default": "./src/prompt-builder.ts"
    },
    "./corbits-vocabulary": {
      "types": "./src/corbits-vocabulary.ts",
      "default": "./src/corbits-vocabulary.ts"
    },
    "./tool-names": {
      "types": "./src/tool-names.ts",
      "default": "./src/tool-names.ts"
    },
    "./dynamic-tools-catalog": {
      "types": "./src/dynamic-tools/catalog.ts",
      "default": "./src/dynamic-tools/catalog.ts"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "default": "./src/constants.ts"
    },
    "./seed": {
      "types": "./src/seed.ts",
      "default": "./src/seed.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text src"
  },
  "dependencies": {
    "arktype": "catalog:",
    "@intx/agent": "workspace:*",
    "@intx/hub-client": "workspace:*",
    "@intx/inference": "workspace:*",
    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*",
    "@workbench/catalog": "workspace:*",
    "@workbench/chat": "workspace:*",
    "@workbench/shared": "workspace:*",
    "@workbench/myra": "workspace:*",
    "@workbench/tools-catalog": "workspace:*",
    "@workbench/prompts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
