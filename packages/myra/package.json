{
  "name": "@workbench/myra",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./seed": {
      "types": "./src/core/seed-files.ts",
      "default": "./src/core/seed-files.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text src"
  },
  "dependencies": {
    "arktype": "catalog:",
    "@intx/inference": "workspace:*",
    "@intx/types": "workspace:*",
    "@workbench/agents": "workspace:*",
    "@workbench/prompts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
