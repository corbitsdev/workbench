{
  "name": "@corbits/workflow-catalog",
  "private": true,
  "description": "Deploy-layer workflow metadata (automatable, display names) mirrored from each workflows/*/package.json corbits.workflow field \u2014 the routines picker and seed share this pure catalog so the browser never reads package.json at runtime",
  "version": "0.0.1",
  "license": "LGPL-2.1-or-later",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./connect-github-routes": "./src/connect-github-routes.ts",
    "./template-block-routes": "./src/template-block-routes.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@corbits/code-review": "workspace:*",
    "@corbits/code-review-workflow": "workspace:*",
    "@corbits/error-sink": "workspace:*",
    "@corbits/github-tools": "workspace:*",
    "@corbits/jimmy-agent": "workspace:*",
    "@corbits/scout-agent": "workspace:*",
    "@corbits/webhook-triggers": "workspace:*",
    "@intx/db": "workspace:*",
    "@intx/hub-api": "workspace:*",
    "@workbench/hub-client": "workspace:*",
    "arktype": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "^4.11.9",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@intx/crypto": "0.3.0",
    "@types/bun": "catalog:",
    "@workbench/connections": "workspace:*",
    "typescript": "catalog:"
  }
}
