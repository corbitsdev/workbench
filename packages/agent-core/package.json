{
  "name": "@workbench/agent-core",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./corbits-vocabulary": {
      "types": "./src/corbits-vocabulary.ts",
      "default": "./src/corbits-vocabulary.ts"
    },
    "./tool-names": {
      "types": "./src/tool-names.ts",
      "default": "./src/tool-names.ts"
    },
    "./dynamic-tools-catalog": {
      "types": "./src/dynamic-tools-catalog.ts",
      "default": "./src/dynamic-tools-catalog.ts"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "default": "./src/constants.ts"
    },
    "./friendly-tool-summary": {
      "types": "./src/friendly-tool-summary.ts",
      "default": "./src/friendly-tool-summary.ts"
    },
    "./parts": {
      "types": "./src/parts.ts",
      "default": "./src/parts.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "BUN_OPTIONS=--conditions=intx-src bun test src",
    "test:coverage": "BUN_OPTIONS=--conditions=intx-src bun test --coverage --coverage-reporter=lcov --coverage-reporter=text src"
  },
  "dependencies": {
    "arktype": "catalog:",
    "@intx/types": "workspace:*",
    "@workbench/shared": "workspace:*",
    "@workbench/tool-manifest": "workspace:*",
    "@workbench/tools-catalog": "workspace:*",
    "@workbench/prompts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
