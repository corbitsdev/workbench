{
  "name": "@workbench/tools-browser",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "bun test src",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text src",
    "smoke": "bun run scripts/smoke.ts"
  },
  "dependencies": {
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "@intx/agent": "workspace:*",
    "@intx/types": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
