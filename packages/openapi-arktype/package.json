{
  "name": "@workbench/openapi-arktype",
  "private": true,
  "description": "Generate arktype validators from OpenAPI specs. Vendored from alexanderguy/openapi-arktype (MIT).",
  "license": "MIT",
  "author": "Alexander Guy (https://github.com/alexanderguy)",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexanderguy/openapi-arktype"
  },
  "bin": {
    "openapi-arktype": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "bun test test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text test"
  },
  "dependencies": {
    "@scalar/openapi-parser": "^0.25.0",
    "arktype": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
