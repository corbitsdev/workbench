{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ESNext"],
    "types": ["bun"],
    "customConditions": ["intx-src"]
  },
  "include": ["src/**/*", "test/**/*"]
}
