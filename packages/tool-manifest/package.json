{
  "name": "@workbench/tool-manifest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./derive": {
      "types": "./src/derive.ts",
      "default": "./src/derive.ts"
    },
    "./committed-index": {
      "types": "./src/committed-index.ts",
      "default": "./src/committed-index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "BUN_OPTIONS=--conditions=intx-src bun test --isolate src",
    "test:coverage": "BUN_OPTIONS=--conditions=intx-src bun test --isolate --coverage --coverage-reporter=lcov --coverage-reporter=text src"
  },
  "dependencies": {
    "arktype": "catalog:"
  },
  "devDependencies": {
    "@workbench/agents": "workspace:*",
    "@workbench/shared": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
