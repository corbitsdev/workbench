{
  "name": "@corbits/worker",
  "version": "0.0.3",
  "description": "Mail-triggered conversational workflow for a bench worker",
  "license": "LGPL-2.1-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/corbitsdev/workbench.git",
    "directory": "packages/worker"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "bundle",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./prompt": "./src/system-prompt.ts",
    "./workflow-ids": "./src/workflow-ids.ts",
    "./definition-json": "./src/definition-json.ts",
    "./bundle": "./src/bundle.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run scripts/build-bundle.ts"
  },
  "dependencies": {
    "@corbits/artifacts": "0.3.0",
    "@corbits/deferred-tools": "workspace:*",
    "@corbits/mcp": "^0.3.1",
    "@corbits/memory": "0.2.1",
    "@intx/tools-mail": "0.5.0",
    "@intx/tools-posix": "0.5.0"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@intx/agent": "workspace:*",
    "@intx/types": "workspace:*",
    "@intx/workflow": "workspace:*"
  },
  "corbits": {
    "workflow": {
      "assetName": "worker",
      "displayName": "Worker",
      "automatable": false
    }
  },
  "interchange": {
    "workflow": "./src/index.ts"
  }
}
