{
  "name": "@workbench/workflows-ui",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    }
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "BUN_OPTIONS=--conditions=intx-src bun test --preload ./src/react/test-setup.ts src",
    "test:coverage": "BUN_OPTIONS=--conditions=intx-src bun test --preload ./src/react/test-setup.ts --coverage --coverage-reporter=lcov --coverage-reporter=text src"
  },
  "dependencies": {
    "@workbench/agents": "workspace:*",
    "arktype": "catalog:"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "//": "Core exports pure derivation; ./react is presentational building blocks with React peers."
}
