# Secrets — never committed; .env.example is the only tracked env file
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Local orchestration / planning artifacts (not product source)
.worktrees/
.agent-state/
.claude/*
!.claude/skills/
dispatch/
specs/
plans/
tmp/

# OS / editor noise
.DS_Store
*.log

# Local runtime state (hub and sidecar data dirs)
.data/

# Local agent scratch (not product source)
.mb-scratch/
.corbits/

# Browser walkthrough harness screenshots + run summary (CL-6072)
scripts/e2e/browser/shots/

# `bun pm pack` / `bun run release` tarballs — built on demand, never
# committed (CL-8167).
*.tgz
